    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CgpRandevuTakip.Desktop\CgpRandevuTakip.Desktop.csproj" />
  </ItemGroup>

</Project>

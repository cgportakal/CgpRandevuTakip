{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Data": {
    "Root": ""
  },
  "Jwt": {
    "AccessTokenMinutes": 30
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "EnableSwagger": true,
  "Features": {
    "mobileOffline": true,
    "pushNotifications": true,
    "webApp": true
  },
  "VersionPolicy": {
    "minDesktopVersion": "1.5.0",
    "minMobileVersion": "1.0.0",
    "minWebVersion": "1.0.0",
    "latestDesktopVersion": "1.6.0",
    "latestMobileVersion": "1.0.0"
  }
}

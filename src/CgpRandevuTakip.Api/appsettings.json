{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Data": {
    "Root": ""
  },
  "Jwt": {
    "AccessTokenMinutes": 30
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "EnableSwagger": true,
  "Push": {
    "Enabled": false,
    "Provider": "ntfy",
    "Topic": "",
    "Token": "",
    "ChatId": ""
  },
  "WebPush": {
    "Subject": "mailto:admin@cgp.local",
    "PublicKey": "",
    "PrivateKey": ""
  },
  "Expo": {
    "Enabled": true,
    "AccessToken": ""
  },
  "Features": {
    "mobileOffline": true,
    "pushNotifications": true,
    "webApp": true
  },
  "VersionPolicy": {
    "minDesktopVersion": "1.5.0",
    "minMobileVersion": "1.0.0",
    "minWebVersion": "1.0.0",
    "latestDesktopVersion": "1.10.0",
    "latestMobileVersion": "1.0.0",
    "latestWebVersion": "1.10.0"
  }
}

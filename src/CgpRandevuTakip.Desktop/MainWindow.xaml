<Window x:Class="CgpRandevuTakip.Desktop.MainWindow"
        Icon="/Assets/CGPRandevuTakip.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CGP - Randevu Takip"
        Height="800" Width="1240"
        MinHeight="680" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Kenar çubuğu -->
        <Border Grid.Column="0"
                Background="{DynamicResource NavBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button Grid.Row="0"
                        Command="{Binding OpenUserAreaCommand}"
                        Style="{StaticResource GhostButton}"
                        Padding="0"
                        Margin="20,22,20,22"
                        HorizontalContentAlignment="Left"
                        ToolTip="Kullanıcı alanı"
                        AutomationProperties.Name="Kullanıcı alanı">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="12"
                                Background="{DynamicResource BrandGradientBrush}">
                            <TextBlock Text="C" Foreground="White" FontSize="20" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="CGP" FontSize="15" FontWeight="Bold" />
                            <TextBlock Text="Randevu Takip" Style="{StaticResource MutedText}" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="ÇALIŞMA ALANI"
                                   Style="{StaticResource MutedText}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Margin="24,8,0,8" />

                        <RadioButton Style="{StaticResource NavButton}"
                                     GroupName="MainNav"
                                     AutomationProperties.Name="Günlük Liste"
                                     IsChecked="{Binding IsAppointmentsSelected}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗓" Width="24" FontSize="13"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Text="Günlük Liste"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavButton}"
                                     GroupName="MainNav"
                                     AutomationProperties.Name="Görüşmeciler"
                                     IsChecked="{Binding IsHostsSelected}"
                                     Visibility="{Binding ShowHostsNav, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👤" Width="24" FontSize="13"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Text="Görüşmeciler"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavButton}"
                                     GroupName="MainNav"
                                     AutomationProperties.Name="Kategoriler"
                                     IsChecked="{Binding IsCategoriesSelected}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▤" Width="24" FontSize="14"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Text="Kategoriler"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavButton}"
                                     GroupName="MainNav"
                                     AutomationProperties.Name="Kullanıcılar"
                                     IsChecked="{Binding IsUsersSelected}"
                                     Visibility="{Binding ShowUsersNav, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚿" Width="24" FontSize="14"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Text="Kullanıcılar"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>

                        <Border Style="{StaticResource Divider}" Margin="18,18,18,12" />

                        <TextBlock Text="SİSTEM"
                                   Style="{StaticResource MutedText}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Margin="24,0,0,8" />

                        <RadioButton Style="{StaticResource NavButton}"
                                     GroupName="MainNav"
                                     AutomationProperties.Name="Kontrol Paneli"
                                     IsChecked="{Binding IsDashboardSelected}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◈" Width="24" FontSize="14"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Text="Kontrol Paneli"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavButton}"
                                     GroupName="MainNav"
                                     AutomationProperties.Name="Yedekleme"
                                     IsChecked="{Binding IsBackupsSelected}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗄" Width="24" FontSize="14"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Text="Yedekleme"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavButton}"
                                     GroupName="MainNav"
                                     AutomationProperties.Name="Denetim Kaydı"
                                     Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}"
                                     IsChecked="{Binding IsAuditSelected}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" Width="24" FontSize="14"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Text="Denetim Kaydı"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavButton}"
                                     GroupName="MainNav"
                                     AutomationProperties.Name="Ayarlar"
                                     IsChecked="{Binding IsSettingsSelected}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" Width="24" FontSize="14"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Text="Ayarlar"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>

                        <Border Style="{StaticResource Divider}" Margin="18,18,18,12" />

                        <TextBlock Text="YAKINDA"
                                   Style="{StaticResource MutedText}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Margin="24,0,0,8" />

                        <TextBlock Text="Alıcı rehberi" Style="{StaticResource MutedText}" Margin="24,6,0,0" />

                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14"
                                Margin="16,24,16,0">
                            <StackPanel>
                                <TextBlock Text="Sprint 3.5 kapsamı" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="Silinenleri geri alma, görüşmeci filtresi ve CRUD doğrulaması."
                                           Style="{StaticResource MutedText}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Margin="12"
                        Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="36" Height="36" CornerRadius="10"
                                Background="{DynamicResource AccentSoftBrush}">
                            <TextBlock Text="{Binding UserInitials}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserDisplayName}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding UserRoleText}"
                                       Style="{StaticResource MutedText}"
                                       FontSize="10" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="Kilitle"
                                    Style="{StaticResource GhostButton}"
                                    Padding="10,6"
                                    MinHeight="30"
                                    FontSize="11"
                                    Margin="0,0,6,0"
                                    Command="{Binding LockCommand}" />
                            <Button Content="Çıkış"
                                    Style="{StaticResource GhostButton}"
                                    Padding="10,6"
                                    MinHeight="30"
                                    FontSize="11"
                                    Command="{Binding LogoutCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Ana içerik -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="28,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitle}" FontSize="22" />
                        <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource PageSubtitle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding OpenUserAreaCommand}"
                                Style="{StaticResource GhostButton}"
                                Padding="0"
                                Margin="0,0,10,0"
                                ToolTip="Kullanıcı alanı"
                                AutomationProperties.Name="Kurum ve kullanıcı alanı">
                            <Border Style="{StaticResource BadgeBorder}">
                                <TextBlock Text="{Binding InstitutionName}"
                                           Style="{StaticResource BadgeText}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="260" />
                            </Border>
                        </Button>
                        <Button Command="{Binding OpenTodayAppointmentsCommand}"
                                Style="{StaticResource GhostButton}"
                                Padding="0"
                                ToolTip="Bugünün listesini aç"
                                AutomationProperties.Name="Bugünün tarihi">
                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,6"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding TodayText}"
                                           Style="{StaticResource MutedText}"
                                           FontWeight="SemiBold" />
                            </Border>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentPage}"
                            Margin="28,22,28,24" />
        </Grid>
    </Grid>
</Window>

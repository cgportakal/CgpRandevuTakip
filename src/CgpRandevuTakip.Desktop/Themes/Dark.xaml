<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Yumuşak yeşil palet: koyu zeminde göz yormayan, yüksek kontrastlı tonlar. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0E1512" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#141D18" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#19241E" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#21322A" />
    <SolidColorBrush x:Key="BorderBrush" Color="#27382E" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#374D40" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EEF6F1" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C6D8CD" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#96AB9E" />

    <SolidColorBrush x:Key="AccentBrush" Color="#74C69D" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#8AD5AE" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1B3428" />
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#2A4D3C" />
    <SolidColorBrush x:Key="RowSelectedHoverBrush" Color="#315944" />
    <SolidColorBrush x:Key="ButtonTextBrush" Color="#0B1710" />

    <SolidColorBrush x:Key="DangerBrush" Color="#E19089" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#3A1F1C" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#74C69D" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#17301F" />
    <SolidColorBrush x:Key="WarningBrush" Color="#DDBB77" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#33290F" />

    <SolidColorBrush x:Key="NavBackgroundBrush" Color="#121B16" />
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#1F3529" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#131C17" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#2E4337" />

    <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#2F7D5D" />
        <GradientStop Offset="0.55" Color="#276A4D" />
        <GradientStop Offset="1" Color="#1F5740" />
    </LinearGradientBrush>
</ResourceDictionary>

<UserControl x:Class="CgpRandevuTakip.Desktop.Views.ReportsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Başlık -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Raporlar" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding RangeText}" Style="{StaticResource PageSubtitle}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="CSV"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ExportCsvCommand}"
                            Margin="0,0,8,0" />
                    <Button Content="PDF"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding ExportPdfCommand}" />
                </StackPanel>
            </Grid>

            <!-- Filtreler -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Bu ay"
                                Style="{StaticResource SubtleButton}"
                                Command="{Binding ApplyPresetCommand}"
                                CommandParameter="thisMonth"
                                Margin="0,0,8,0" />
                        <Button Content="Geçen ay"
                                Style="{StaticResource SubtleButton}"
                                Command="{Binding ApplyPresetCommand}"
                                CommandParameter="lastMonth"
                                Margin="0,0,8,0" />
                        <Button Content="Bu yıl"
                                Style="{StaticResource SubtleButton}"
                                Command="{Binding ApplyPresetCommand}"
                                CommandParameter="thisYear"
                                Margin="0,0,8,0" />
                        <Button Content="Son 30 gün"
                                Style="{StaticResource SubtleButton}"
                                Command="{Binding ApplyPresetCommand}"
                                CommandParameter="last30" />
                    </StackPanel>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Başlangıç" Style="{StaticResource LabelText}" />
                            <DatePicker SelectedDate="{Binding FromDate}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Bitiş" Style="{StaticResource LabelText}" />
                            <DatePicker SelectedDate="{Binding ToDate}" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Kategori" Style="{StaticResource LabelText}" />
                            <ComboBox ItemsSource="{Binding CategoryFilters}"
                                      SelectedItem="{Binding SelectedCategoryFilter}"
                                      DisplayMemberPath="Label"
                                      AutomationProperties.Name="Rapor kategorisi" />
                        </StackPanel>

                        <StackPanel Grid.Column="6"
                                    Visibility="{Binding ShowHostFilter, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Görüşmeci" Style="{StaticResource LabelText}" />
                            <ComboBox ItemsSource="{Binding HostFilters}"
                                      SelectedItem="{Binding SelectedHostFilter}"
                                      DisplayMemberPath="Label"
                                      AutomationProperties.Name="Rapor görüşmecisi" />
                        </StackPanel>

                        <Button Grid.Column="7"
                                Content="Uygula"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding LoadCommand}"
                                VerticalAlignment="Bottom"
                                Margin="12,0,0,0" />
                    </Grid>

                    <TextBlock Text="{Binding LastUpdatedText}"
                               Style="{StaticResource MutedText}"
                               Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource DangerSoftBrush}"
                    BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="12,10"
                    Margin="0,14,0,0"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource DangerBrush}"
                           FontSize="12"
                           TextWrapping="Wrap" />
            </Border>

            <!-- KPI kartları -->
            <UniformGrid Columns="5" Margin="0,16,0,0">
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="TOPLAM GÖRÜŞME" Style="{StaticResource LabelText}" />
                        <TextBlock Text="{Binding Summary.Total}" Style="{StaticResource ValueText}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="8,0">
                    <StackPanel>
                        <TextBlock Text="TAMAMLANDI" Style="{StaticResource LabelText}" />
                        <TextBlock Text="{Binding Summary.CompletionRateText}" Style="{StaticResource ValueText}" />
                        <TextBlock Text="{Binding Summary.Completed}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="8,0">
                    <StackPanel>
                        <TextBlock Text="GELMEDİ" Style="{StaticResource LabelText}" />
                        <TextBlock Text="{Binding Summary.NoShowRateText}" Style="{StaticResource ValueText}"
                                   Foreground="{DynamicResource DangerBrush}" />
                        <TextBlock Text="{Binding Summary.NoShow}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="8,0">
                    <StackPanel>
                        <TextBlock Text="İPTAL" Style="{StaticResource LabelText}" />
                        <TextBlock Text="{Binding Summary.CancelRateText}" Style="{StaticResource ValueText}" />
                        <TextBlock Text="{Binding Summary.Cancelled}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="ORTALAMA SÜRE" Style="{StaticResource LabelText}" />
                        <TextBlock Text="{Binding Summary.AverageDurationText}" Style="{StaticResource ValueText}" />
                        <TextBlock Text="{Binding TotalDurationSummary}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource SoftCard}" Margin="0,12,0,0">
                <TextBlock Text="{Binding PersonSummary}"
                           Style="{StaticResource MutedText}"
                           TextWrapping="Wrap" />
            </Border>

            <!-- Dağılım grafiği -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                    Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding BucketTitle}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource MutedText}">
                            <Run Text="Toplam:" />
                            <Run Text="{Binding Summary.Total, Mode=OneWay}" />
                            <Run Text=" · Tamamlanan:" />
                            <Run Text="{Binding Summary.Completed, Mode=OneWay}" />
                        </TextBlock>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Bars}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3,0,0" ToolTip="{Binding Tooltip}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="236" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Label}"
                                               Style="{StaticResource MutedText}"
                                               FontSize="11"
                                               VerticalAlignment="Center" />

                                    <Border Grid.Column="1"
                                            Height="10"
                                            Width="220"
                                            CornerRadius="5"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource SurfaceAltBrush}">
                                        <Border Height="10"
                                                Width="{Binding Width}"
                                                CornerRadius="5"
                                                HorizontalAlignment="Left"
                                                Background="{DynamicResource AccentBrush}" />
                                    </Border>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding ValueText}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Kategori ve görüşmeci tabloları -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}"
                        Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Kategori dağılımı" Style="{StaticResource SectionTitle}" />

                        <Grid Margin="0,10,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="KATEGORİ" Style="{StaticResource LabelText}" />
                            <TextBlock Grid.Column="1" Text="TOPLAM" Style="{StaticResource LabelText}" />
                            <TextBlock Grid.Column="2" Text="TAMAM." Style="{StaticResource LabelText}" />
                            <TextBlock Grid.Column="3" Text="PAY" Style="{StaticResource LabelText}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding CategoryRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="9" Height="9" CornerRadius="5"
                                                    Margin="0,0,7,0"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}" />
                                            <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding Total}" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="{Binding Completed}" FontSize="12" />
                                        <TextBlock Grid.Column="3" Text="{Binding ShareText}" Style="{StaticResource MutedText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}"
                        Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Görüşmeci dağılımı" Style="{StaticResource SectionTitle}" />

                        <Grid Margin="0,10,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="46" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="46" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="GÖRÜŞMECİ" Style="{StaticResource LabelText}" />
                            <TextBlock Grid.Column="1" Text="TOPLAM" Style="{StaticResource LabelText}" />
                            <TextBlock Grid.Column="2" Text="TAMAM." Style="{StaticResource LabelText}" />
                            <TextBlock Grid.Column="3" Text="İPTAL" Style="{StaticResource LabelText}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding HostRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="46" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Total}" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="{Binding Completed}" FontSize="12" />
                                        <TextBlock Grid.Column="3" Text="{Binding Cancelled}" FontSize="12" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Saat dağılımı -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                    Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Saat dağılımı" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding HourRows}" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SoftCard}"
                                        CornerRadius="6"
                                        Padding="10,6"
                                        Margin="0,0,8,8"
                                        ToolTip="{Binding Tooltip}">
                                    <TextBlock FontSize="11">
                                        <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text=" · " Foreground="{DynamicResource TextMutedBrush}" />
                                        <Run Text="{Binding Total, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Boş durum -->
            <Border Style="{StaticResource SoftCard}" Margin="0,16,0,0"
                    Visibility="{Binding IsEmptyReport, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Bu aralıkta görüşme bulunmuyor." FontWeight="SemiBold" />
                    <TextBlock Text="Farklı bir tarih aralığı seçin veya filtreleri temizleyin."
                               Style="{StaticResource MutedText}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<Window x:Class="CgpRandevuTakip.Desktop.Views.ChangePasswordWindow"
        Icon="/Assets/CGPRandevuTakip.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Şifre değiştir"
        Width="470"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">

    <StackPanel Margin="28">
        <TextBlock Text="Şifre değiştir" Style="{StaticResource PageTitle}" FontSize="22" />
        <TextBlock Text="Yeni şifre en az 8 karakter olmalı; en az bir harf ve bir rakam içermelidir."
                   Style="{StaticResource PageSubtitle}" Margin="0,4,0,22" />

        <TextBlock Text="Mevcut şifre" Style="{StaticResource LabelText}" />
        <PasswordBox x:Name="CurrentPasswordBox" PasswordChanged="OnCurrentPasswordChanged" />

        <TextBlock Text="Yeni şifre" Style="{StaticResource LabelText}" Margin="0,16,0,6" />
        <PasswordBox x:Name="NewPasswordBox" PasswordChanged="OnNewPasswordChanged" />

        <TextBlock Text="Yeni şifre (tekrar)" Style="{StaticResource LabelText}" Margin="0,16,0,6" />
        <PasswordBox x:Name="ConfirmPasswordBox" PasswordChanged="OnConfirmPasswordChanged" />

        <Border Background="{DynamicResource DangerSoftBrush}"
                BorderBrush="{DynamicResource DangerBrush}"
                BorderThickness="1"
                CornerRadius="9"
                Padding="12,10"
                Margin="0,18,0,0"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource DangerBrush}"
                       FontSize="12"
                       TextWrapping="Wrap" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Vazgeç"
                    Style="{StaticResource GhostButton}"
                    IsCancel="True"
                    Margin="0,0,10,0" />
            <Button Content="Şifreyi güncelle"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding SaveCommand}"
                    IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>

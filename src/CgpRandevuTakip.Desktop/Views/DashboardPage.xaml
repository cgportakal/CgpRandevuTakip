<UserControl x:Class="CgpRandevuTakip.Desktop.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Karşılama -->
            <Border CornerRadius="16" Padding="28"
                    Background="{DynamicResource BrandGradientBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding Greeting}"
                                   Foreground="White"
                                   FontSize="26"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding RoleText}"
                                   Foreground="#D9FFFFFF"
                                   FontSize="12"
                                   Margin="0,6,0,0" />
                        <TextBlock Text="Bugünün akışı Sprint 2'de görüşme listesiyle birlikte açılacak. Şimdilik kurulum, roller, tema ve kategoriler hazır."
                                   Foreground="#E6FFFFFF"
                                   FontSize="13"
                                   LineHeight="21"
                                   TextWrapping="Wrap"
                                   MaxWidth="560"
                                   HorizontalAlignment="Left"
                                   Margin="0,16,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <Button Content="Kategoriler"
                                Style="{StaticResource AppButtonBase}"
                                Background="#33FFFFFF"
                                Foreground="White"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="categories"
                                Margin="0,0,10,0" />
                        <Button Content="Ayarlar"
                                Style="{StaticResource AppButtonBase}"
                                Background="#22FFFFFF"
                                Foreground="White"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="settings" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Özet kartları -->
            <UniformGrid Columns="4" Margin="0,18,0,0">
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="AKTİF KATEGORİ" Style="{StaticResource LabelText}" />
                        <TextBlock Text="{Binding ActiveCategoryCount}" Style="{StaticResource ValueText}" />
                        <TextBlock Text="{Binding CategorySummary}"
                                   Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="10,0">
                    <StackPanel>
                        <TextBlock Text="KULLANICI" Style="{StaticResource LabelText}" />
                        <TextBlock Text="{Binding UserCount}" Style="{StaticResource ValueText}" />
                        <TextBlock Text="Yerel hesaplar" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="10,0">
                    <StackPanel>
                        <TextBlock Text="TEMA" Style="{StaticResource LabelText}" />
                        <TextBlock Text="{Binding ThemeText}" Style="{StaticResource ValueText}" FontSize="22" />
                        <TextBlock Text="Anında uygulanır" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="VERİ ŞEMASI" Style="{StaticResource LabelText}" />
                        <TextBlock Text="{Binding SchemaVersionText}" Style="{StaticResource ValueText}" />
                        <TextBlock Text="SQLite · EF Core" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Sprint 1 · Tamamlananlar" Style="{StaticResource SectionTitle}" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="18" Height="18" CornerRadius="9"
                                    Background="{DynamicResource SuccessSoftBrush}" VerticalAlignment="Top">
                                <TextBlock Text="✓" Foreground="{DynamicResource SuccessBrush}" FontSize="10"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="İlk yönetici hesabı ve giriş"
                                       FontSize="13" TextWrapping="Wrap" />
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="18" Height="18" CornerRadius="9"
                                    Background="{DynamicResource SuccessSoftBrush}" VerticalAlignment="Top">
                                <TextBlock Text="✓" Foreground="{DynamicResource SuccessBrush}" FontSize="10"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="Rol bazlı yetki kontrolü (Yönetici / Sekreter / Görüşmeci)"
                                       FontSize="13" TextWrapping="Wrap" />
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="18" Height="18" CornerRadius="9"
                                    Background="{DynamicResource SuccessSoftBrush}" VerticalAlignment="Top">
                                <TextBlock Text="✓" Foreground="{DynamicResource SuccessBrush}" FontSize="10"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="Koyu / açık / otomatik tema ve kalıcı ayar"
                                       FontSize="13" TextWrapping="Wrap" />
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="18" Height="18" CornerRadius="9"
                                    Background="{DynamicResource SuccessSoftBrush}" VerticalAlignment="Top">
                                <TextBlock Text="✓" Foreground="{DynamicResource SuccessBrush}" FontSize="10"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="Kategori yönetimi: ekleme, düzenleme, sıralama, pasifleştirme"
                                       FontSize="13" TextWrapping="Wrap" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="18" Height="18" CornerRadius="9"
                                    Background="{DynamicResource WarningSoftBrush}" VerticalAlignment="Top">
                                <TextBlock Text="•" Foreground="{DynamicResource WarningBrush}" FontSize="10"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="S-01 / S-02 spike'ları: Ayarlar > Tanılama altından çalıştırın"
                                       FontSize="13" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Sistem bilgileri" Style="{StaticResource SectionTitle}" />

                        <TextBlock Text="VARSAYILAN HATIRLATICI" Style="{StaticResource LabelText}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding ReminderText}" FontSize="13" Margin="0,0,0,14" />

                        <TextBlock Text="KURUM" Style="{StaticResource LabelText}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding InstitutionName}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,14" />

                        <TextBlock Text="VERİTABANI" Style="{StaticResource LabelText}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding DatabasePath}"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />

                        <TextBlock Text="YEDEK KLASÖRÜ" Style="{StaticResource LabelText}" Margin="0,14,0,2" />
                        <TextBlock Text="{Binding BackupDirectory}"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />

                        <Border Style="{StaticResource Divider}" Margin="0,16,0,12" />

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding VersionText}" Style="{StaticResource MutedText}" />
                            <TextBlock Text="  ·  " Style="{StaticResource MutedText}" />
                            <TextBlock Text="{Binding LastRefreshedText}" Style="{StaticResource MutedText}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

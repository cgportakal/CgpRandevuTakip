<Window x:Class="CgpRandevuTakip.Desktop.Views.ForgotPasswordWindow"
        Icon="/Assets/CGPRandevuTakip.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Şifre sıfırlama · CGP - Randevu Takip"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">
    <StackPanel Margin="28">
        <TextBlock Text="Şifre sıfırlama" Style="{StaticResource PageTitle}" FontSize="22" />
        <TextBlock Text="Kayıtlı e-posta adresinize 6 haneli bir kod gönderilecek."
                   Style="{StaticResource PageSubtitle}"
                   Margin="0,6,0,20" />

        <TextBlock Text="E-posta" Style="{StaticResource LabelText}" />
        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                 MaxLength="200"
                 AutomationProperties.Name="Şifre sıfırlama e-posta" />

        <Button Content="Kod gönder"
                Style="{StaticResource SecondaryButton}"
                Command="{Binding SendCodeCommand}"
                HorizontalAlignment="Left"
                Margin="0,12,0,0" />

        <StackPanel Visibility="{Binding IsCodeSent, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Doğrulama kodu" Style="{StaticResource LabelText}" Margin="0,18,0,6" />
            <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="6"
                     AutomationProperties.Name="Doğrulama kodu" />

            <TextBlock Text="Yeni şifre" Style="{StaticResource LabelText}" Margin="0,14,0,6" />
            <PasswordBox x:Name="NewPasswordBox"
                         PasswordChanged="OnNewPasswordChanged"
                         AutomationProperties.Name="Yeni şifre" />

            <TextBlock Text="Yeni şifre (tekrar)" Style="{StaticResource LabelText}" Margin="0,12,0,6" />
            <PasswordBox x:Name="ConfirmPasswordBox"
                         PasswordChanged="OnConfirmPasswordChanged"
                         AutomationProperties.Name="Yeni şifre tekrar" />

            <Button Content="Şifreyi sıfırla"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding ResetCommand}"
                    HorizontalAlignment="Left"
                    Margin="0,16,0,0" />
        </StackPanel>

        <Border Background="{DynamicResource DangerSoftBrush}"
                BorderBrush="{DynamicResource DangerBrush}"
                BorderThickness="1"
                CornerRadius="9"
                Padding="12,10"
                Margin="0,16,0,0"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource DangerBrush}"
                       FontSize="12"
                       TextWrapping="Wrap" />
        </Border>

        <Border Background="{DynamicResource AccentSoftBrush}"
                CornerRadius="9"
                Padding="12,10"
                Margin="0,16,0,0"
                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource AccentBrush}"
                       FontSize="12"
                       TextWrapping="Wrap" />
        </Border>

        <Button Content="Kapat"
                Style="{StaticResource GhostButton}"
                Command="{Binding CloseCommand}"
                HorizontalAlignment="Left"
                Margin="0,18,0,0" />
    </StackPanel>
</Window>

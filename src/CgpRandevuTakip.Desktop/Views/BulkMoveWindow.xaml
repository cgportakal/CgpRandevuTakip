<Window x:Class="CgpRandevuTakip.Desktop.Views.BulkMoveWindow"
        Icon="/Assets/CGPRandevuTakip.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="520"
        Height="470"
        MinWidth="480"
        MinHeight="440"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" FontSize="22" />
            <TextBlock Text="{Binding CountText}" Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Yeni tarih *" Style="{StaticResource LabelText}" />
                <DatePicker SelectedDate="{Binding NewDate}"
                            MinHeight="40"
                            AutomationProperties.Name="Yeni tarih" />

                <TextBlock Text="Saat" Style="{StaticResource SectionTitle}" Margin="0,18,0,4" />

                <RadioButton Content="Saatleri koru (her görüşme kendi saatinde taşınır)"
                             IsChecked="{Binding KeepTimes, Mode=TwoWay}"
                             Margin="0,0,0,8"
                             AutomationProperties.Name="Saatleri koru" />

                <RadioButton Content="Tümünü aynı saate taşı"
                             IsChecked="{Binding UseNewTime, Mode=TwoWay}"
                             Margin="0,0,0,8"
                             AutomationProperties.Name="Tümünü aynı saate taşı" />

                <ComboBox ItemsSource="{Binding TimeOptions}"
                          SelectedItem="{Binding NewTimeText, Mode=TwoWay}"
                          IsTextSearchEnabled="True"
                          Width="150"
                          HorizontalAlignment="Left"
                          IsEnabled="{Binding UseNewTime}"
                          AutomationProperties.Name="Yeni saat" />

                <TextBlock Text="Çakışan görüşmeler taşınmadan önce onay istenir."
                           Style="{StaticResource MutedText}"
                           TextWrapping="Wrap"
                           Margin="0,16,0,0" />

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource DangerBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Content="Vazgeç"
                    Style="{StaticResource GhostButton}"
                    Command="{Binding CancelCommand}"
                    HorizontalAlignment="Left" />

            <Button Grid.Column="1"
                    Content="Taşı"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding MoveCommand}" />
        </Grid>
    </Grid>
</Window>

<Window x:Class="CgpRandevuTakip.Desktop.Views.ReminderPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hatırlatıcı önizleme"
        Width="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">

    <StackPanel Margin="26">
        <Border Style="{StaticResource BadgeBorder}" HorizontalAlignment="Left">
            <TextBlock Text="S-02 · HATIRLATICI ÖNİZLEME" Style="{StaticResource BadgeText}" />
        </Border>

        <TextBlock Text="Sıradaki görüşme 30 dakika sonra"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0,16,0,0" />
        <TextBlock Text="Bu pencere Sprint 4'te gerçek hatırlatıcı motoruna bağlanacak."
                   Style="{StaticResource MutedText}" Margin="0,4,0,0" />

        <Border Style="{StaticResource SoftCard}" Margin="0,18,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Örnek Veli" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="Veli Görüşmesi · Yüz yüze" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    <TextBlock Text="Host: Ayşe Yılmaz" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                    <TextBlock Text="Telefon: 05** *** ** 67" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="14:30" FontSize="26" FontWeight="Bold" HorizontalAlignment="Right" />
                    <TextBlock Text="Bugün" Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Text="Ne yapmak istersiniz?" Style="{StaticResource LabelText}" Margin="0,18,0,8" />

        <Grid x:Name="ActionGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Grid.Column="0"
                    Content="Sadece kapat"
                    Style="{StaticResource SecondaryButton}"
                    Tag="Sadece kapatıldı (önizleme)"
                    Click="OnActionClick" />
            <Button Grid.Row="0" Grid.Column="2"
                    Content="Host'a bilgi ver"
                    Style="{StaticResource SubtleButton}"
                    Tag="Host'a bilgi verildi (önizleme)"
                    Click="OnActionClick" />
            <Button Grid.Row="2" Grid.Column="0"
                    Content="Ulaşılamadı · 10 dk ertele"
                    Style="{StaticResource SecondaryButton}"
                    Tag="10 dakika ertelendi (önizleme)"
                    Click="OnActionClick" />
            <Button Grid.Row="2" Grid.Column="2"
                    Content="Ziyaretçi iptal etti"
                    Style="{StaticResource DangerButton}"
                    Tag="Ziyaretçi iptal etti (önizleme)"
                    Click="OnActionClick" />
        </Grid>

        <TextBlock x:Name="StatusText"
                   Style="{StaticResource MutedText}"
                   Foreground="{DynamicResource SuccessBrush}"
                   Margin="0,14,0,0"
                   Visibility="Collapsed" />

        <Border Style="{StaticResource Divider}" Margin="0,18" />

        <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Toast önizle"
                        Style="{StaticResource SecondaryButton}"
                        Click="OnToastClick" />
                <Button Content="Kapat"
                        Style="{StaticResource GhostButton}"
                        Click="OnCloseClick"
                        Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock Text="Bildirim içeriğinde kişi adı gösterilmez (KVKK)."
                       Style="{StaticResource MutedText}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
        </Grid>
    </StackPanel>
</Window>

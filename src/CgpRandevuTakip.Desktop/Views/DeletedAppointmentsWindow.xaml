<Window x:Class="CgpRandevuTakip.Desktop.Views.DeletedAppointmentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Silinen görüşmeler"
        Width="860"
        Height="600"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="SİLİNEN GÖRÜŞMELER" Style="{StaticResource LabelText}" />
                <TextBlock Text="Silinen görüşmeler"
                           Style="{StaticResource PageTitle}"
                           FontSize="24"
                           Margin="0,2,0,0" />
                <TextBlock Text="Silinen kayıtlar 30 gün boyunca geri alınabilir. Süre dolunca kalıcı olarak silinir."
                           Style="{StaticResource MutedText}"
                           Margin="0,5,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Yenile"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding LoadCommand}"
                        Margin="0,0,8,0" />
                <Button Content="Kapat"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding CloseCommand}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Background="{DynamicResource DangerSoftBrush}"
                BorderBrush="{DynamicResource DangerBrush}"
                BorderThickness="1"
                CornerRadius="9"
                Padding="12,10"
                Margin="0,0,0,12"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource DangerBrush}"
                       FontSize="12"
                       TextWrapping="Wrap" />
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <Grid>
                <DataGrid ItemsSource="{Binding Appointments}"
                          SelectedItem="{Binding SelectedAppointment, Mode=TwoWay}"
                          BorderThickness="0"
                          Background="Transparent"
                          AlternatingRowBackground="Transparent"
                          IsReadOnly="True"
                          AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="AD SOYAD" Binding="{Binding PersonFullName}" Width="*" MinWidth="150" />
                        <DataGridTextColumn Header="TARİH" Binding="{Binding DateLabel}" Width="100" />
                        <DataGridTextColumn Header="SAAT" Binding="{Binding TimeLabel}" Width="70" />
                        <DataGridTextColumn Header="HOST" Binding="{Binding HostName}" Width="130" />
                        <DataGridTextColumn Header="KATEGORİ" Binding="{Binding CategoryName}" Width="140" />
                        <DataGridTextColumn Header="SİLİNME" Binding="{Binding DeletedAtText}" Width="130" />
                        <DataGridTextColumn Header="KALAN" Binding="{Binding RemainingText}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="Silinen görüşme yok."
                           Style="{StaticResource MutedText}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding HasAppointments, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource SuccessBrush}"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />

            <Button Grid.Column="1"
                    Content="Seçili görüşmeyi geri al"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding RestoreCommand}" />
        </Grid>
    </Grid>
</Window>

<Window x:Class="CgpRandevuTakip.Desktop.Views.ShareDailyListWindow"
        Icon="/Assets/CGPRandevuTakip.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Günlük listeyi paylaş · CGP - Randevu Takip"
        Width="1040"
        Height="760"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="GÜNLÜK PAYLAŞIM" Style="{StaticResource LabelText}" />
                <TextBlock Text="{Binding DateLabel}" Style="{StaticResource PageTitle}" FontSize="24" />
                <TextBlock Text="{Binding RowCount, StringFormat={}{0} görüşme}"
                           Style="{StaticResource MutedText}" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Alıcı rehberi"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding OpenRecipientsCommand}"
                        Margin="0,0,8,0" />
                <Button Content="Kapat"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding CloseCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <Image Source="{Binding PreviewImage}"
                           Stretch="Uniform"
                           StretchDirection="DownOnly"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top" />
                </ScrollViewer>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Alıcılar" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding SelectedCountText}"
                               Style="{StaticResource MutedText}"
                               Margin="0,-6,0,10" />

                    <ItemsControl ItemsSource="{Binding Recipients}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding DisplayText}"
                                          IsChecked="{Binding IsSelected}"
                                          Margin="0,0,0,8" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource Divider}" Margin="0,10" />

                    <TextBlock Text="Mesaj metni" Style="{StaticResource LabelText}" />
                    <TextBox Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="90"
                             VerticalContentAlignment="Top" />

                    <TextBlock Text="Görsel panoya kopyalanır; WhatsApp açılır. Görseli sohbete Ctrl+V ile yapıştırın."
                               Style="{StaticResource MutedText}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource DangerBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" />
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource SuccessBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Sadece panoya kopyala"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding CopyOnlyCommand}"
                        Margin="0,0,8,0" />
                <Button Content="Panoya kopyala ve WhatsApp'ı aç"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding PrepareAndOpenCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

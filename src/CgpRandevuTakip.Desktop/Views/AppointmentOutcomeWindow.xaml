<Window x:Class="CgpRandevuTakip.Desktop.Views.AppointmentOutcomeWindow"
        Icon="/Assets/CGPRandevuTakip.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Görüşme sonucu"
        Width="640"
        Height="700"
        MinWidth="560"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" FontSize="22" />
            <TextBlock Text="{Binding AppointmentSummary}"
                       Style="{StaticResource PageSubtitle}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Katılım" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Görüşmenin gerçekleşme durumunu seçin. Durum rozeti buna göre güncellenir."
                                   Style="{StaticResource MutedText}" Margin="0,-6,0,12" />

                        <ComboBox ItemsSource="{Binding AttendanceOptions}"
                                  SelectedItem="{Binding SelectedAttendance}"
                                  DisplayMemberPath="Label"
                                  AutomationProperties.Name="Katılım durumu" />

                        <CheckBox Content="Görüşme kapandı"
                                  IsChecked="{Binding IsClosed}"
                                  IsEnabled="{Binding IsClosedEditable}"
                                  Margin="0,16,0,0"
                                  AutomationProperties.Name="Görüşme kapandı" />
                        <TextBlock Text="{Binding ClosedHint}"
                                   Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                        Visibility="{Binding ShowPostponeFields, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Yeni tarih ve saat" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Erteleme için gelecekte bir tarih/saat seçin. Kaydederken onay istenir."
                                   Style="{StaticResource MutedText}" Margin="0,-6,0,12" TextWrapping="Wrap" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tarih *" Style="{StaticResource LabelText}" />
                                <DatePicker SelectedDate="{Binding PostponeDate}"
                                            AutomationProperties.Name="Erteleme tarihi" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Saat *" Style="{StaticResource LabelText}" />
                                <ComboBox ItemsSource="{Binding TimeOptions}"
                                          SelectedItem="{Binding PostponeTimeText, Mode=TwoWay}"
                                          IsTextSearchEnabled="True"
                                          AutomationProperties.Name="Erteleme saati" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Görüşmenin değerlendirmesi" Style="{StaticResource SectionTitle}" />

                        <TextBox Text="{Binding Summary, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="4000"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="96"
                                 VerticalContentAlignment="Top"
                                 AutomationProperties.Name="Görüşmenin değerlendirmesi" />

                        <CheckBox Content="Tekrar randevu gerekiyor"
                                  IsChecked="{Binding WillRepeat}"
                                  Margin="0,16,0,0"
                                  AutomationProperties.Name="Tekrar randevu gerekiyor" />
                        <TextBlock Text="İşaretlenirse detay ekranında 'Tekrar randevu oluştur' düğmesi görünür."
                                   Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />

                        <TextBlock Text="Görüşme sonrası açıklama"
                                   Style="{StaticResource LabelText}"
                                   Margin="0,16,0,6" />
                        <TextBox Text="{Binding PostNotes, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="4000"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="82"
                                 VerticalContentAlignment="Top"
                                 AutomationProperties.Name="Görüşme sonrası açıklama" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <Border Background="{DynamicResource DangerSoftBrush}"
                    BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="12,10"
                    Margin="0,0,0,10"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource DangerBrush}"
                           FontSize="12"
                           TextWrapping="Wrap" />
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Vazgeç"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding CancelCommand}"
                        IsCancel="True"
                        Margin="0,0,10,0" />
                <Button Content="Sonucu kaydet"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveCommand}"
                        IsDefault="True"
                        MinWidth="140" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>

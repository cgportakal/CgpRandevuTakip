<Window x:Class="CgpRandevuTakip.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Giriş · CGP - Randevu Takip"
        Height="700" Width="1040"
        MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Marka paneli -->
        <Border Grid.Column="0" Background="{DynamicResource BrandGradientBrush}">
            <Grid>
                <Ellipse Width="420" Height="420" Fill="#22FFFFFF"
                         HorizontalAlignment="Left" VerticalAlignment="Top"
                         Margin="-140,-160,0,0" />
                <Ellipse Width="320" Height="320" Fill="#14FFFFFF"
                         HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Margin="0,0,-100,-120" />

                <StackPanel Margin="56,52,48,44">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" CornerRadius="12" Background="#33FFFFFF">
                            <TextBlock Text="C" FontSize="21" FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="CGP" Foreground="White" FontSize="17" FontWeight="Bold" />
                            <TextBlock Text="Randevu Takip" Foreground="#D9FFFFFF" FontSize="11" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Randevu akışınızı&#x0a;tek ekranda yönetin."
                               Foreground="White"
                               FontSize="34"
                               FontWeight="Bold"
                               LineHeight="44"
                               Margin="0,64,0,0" />

                    <TextBlock Text="Günlük görüşme listesi, hatırlatıcılar ve görüşme sonuçları; eğitim kurumunuzun akışına uygun, yerel ve güvenli."
                               Foreground="#E6FFFFFF"
                               FontSize="14"
                               LineHeight="23"
                               TextWrapping="Wrap"
                               Margin="0,18,0,0"
                               MaxWidth="390"
                               HorizontalAlignment="Left" />

                    <StackPanel Margin="0,40,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Ellipse Width="6" Height="6" Fill="White" VerticalAlignment="Center" />
                            <TextBlock Text="Yerel veri; PII buluta gönderilmez" Foreground="#E6FFFFFF"
                                       FontSize="12" Margin="12,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Ellipse Width="6" Height="6" Fill="White" VerticalAlignment="Center" />
                            <TextBlock Text="Rol bazlı erişim: Yönetici, Sekreter, Görüşmeci" Foreground="#E6FFFFFF"
                                       FontSize="12" Margin="12,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="White" VerticalAlignment="Center" />
                            <TextBlock Text="Windows bildirimi + isteğe bağlı telefon push" Foreground="#E6FFFFFF"
                                       FontSize="12" Margin="12,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Sprint 1 · Giriş, roller, tema ve kategoriler"
                               Foreground="#B3FFFFFF"
                               FontSize="11"
                               Margin="0,0,0,0"
                               VerticalAlignment="Bottom" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Form paneli -->
        <Grid Grid.Column="1">
            <StackPanel Width="340" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Oturum aç" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Devam etmek için kullanıcı adınızı ve şifrenizi girin."
                           Style="{StaticResource PageSubtitle}"
                           Margin="0,6,0,28" />

                <TextBlock Text="Kullanıcı adı" Style="{StaticResource LabelText}" />
                <TextBox x:Name="UsernameBox"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Kullanıcı adı" />

                <TextBlock Text="Şifre" Style="{StaticResource LabelText}" Margin="0,18,0,6" />
                <PasswordBox x:Name="PasswordBox"
                             PasswordChanged="OnPasswordChanged"
                             KeyDown="OnPasswordKeyDown"
                             AutomationProperties.Name="Şifre" />

                <Border Background="{DynamicResource DangerSoftBrush}"
                        BorderBrush="{DynamicResource DangerBrush}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="12,10"
                        Margin="0,18,0,0"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource DangerBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </Border>

                <Button Content="Giriş yap"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoginCommand}"
                        IsDefault="True"
                        Margin="0,24,0,0"
                        Height="44" />

                <TextBlock Text="Giriş yapılıyor..."
                           Style="{StaticResource MutedText}"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Text="Şifrenizi unuttuysanız yöneticinizle iletişime geçin."
                           Style="{StaticResource MutedText}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,26,0,0" />

                <Border Style="{StaticResource Divider}" Margin="0,30" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="CGP - Randevu Takip" Style="{StaticResource MutedText}" />
                    <TextBlock Text="  ·  " Style="{StaticResource MutedText}" />
                    <TextBlock Text="Tüm hakları saklıdır." Style="{StaticResource MutedText}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

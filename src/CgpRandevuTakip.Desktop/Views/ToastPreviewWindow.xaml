<Window x:Class="CgpRandevuTakip.Desktop.Views.ToastPreviewWindow"
        Icon="/Assets/CGPRandevuTakip.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Toast önizleme"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Opacity="0">

    <Border Width="390"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="5" Opacity="0.32" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Width="38" Height="38" CornerRadius="11"
                    Background="{DynamicResource BrandGradientBrush}"
                    VerticalAlignment="Top">
                <TextBlock Text="C" Foreground="White" FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" Margin="10,0,8,0">
                <TextBlock Text="CGP · Randevu Takip"
                           Style="{StaticResource MutedText}"
                           FontSize="10"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="TitleText"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Margin="0,3,0,0" />
                <TextBlock x:Name="BodyText"
                           Style="{StaticResource MutedText}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <Button Grid.Column="2"
                    Content="✕"
                    Style="{StaticResource GhostButton}"
                    Padding="8,4"
                    MinHeight="26"
                    FontSize="10"
                    Click="OnCloseClick"
                    VerticalAlignment="Top" />
        </Grid>
    </Border>
</Window>

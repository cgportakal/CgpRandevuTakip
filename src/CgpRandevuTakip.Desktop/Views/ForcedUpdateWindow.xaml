<Window x:Class="CgpRandevuTakip.Desktop.Views.ForcedUpdateWindow"
        Icon="/Assets/CGPRandevuTakip.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Güncelleme gerekli · CGP - Randevu Takip"
        Width="540"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="30">
        <StackPanel>
            <Border Width="56" Height="56" CornerRadius="16"
                    Background="{DynamicResource AccentSoftBrush}"
                    HorizontalAlignment="Left">
                <TextBlock Text="⬆" FontSize="26"
                           Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <TextBlock Text="Güncelleme gerekli" Style="{StaticResource PageTitle}" FontSize="24" Margin="0,18,0,0" />
            <TextBlock Text="Bu sürüm artık desteklenmiyor. Devam etmek için uygulamayı güncelleyin."
                       Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />

            <Border Style="{StaticResource SoftCard}" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Mevcut sürüm" Style="{StaticResource MutedText}" Margin="0,0,16,6" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="CurrentVersionText" Style="{StaticResource ValueText}" Margin="0,0,0,6" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Gerekli sürüm" Style="{StaticResource MutedText}" Margin="0,0,16,6" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="RequiredVersionText" Style="{StaticResource ValueText}" Margin="0,0,0,6" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Son sürüm" Style="{StaticResource MutedText}" Margin="0,0,16,0" />
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="LatestVersionText" Style="{StaticResource ValueText}" />
                </Grid>
            </Border>

            <TextBlock Text="Sürüm notları" Style="{StaticResource LabelText}" Margin="0,16,0,6" />
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="12,10"
                    MaxHeight="180">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ReleaseNotesText" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="Sürüm notları yükleniyor…" />
                </ScrollViewer>
            </Border>

            <Border Background="{DynamicResource DangerSoftBrush}"
                    BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="12,10"
                    Margin="0,14,0,0"
                    Visibility="Collapsed"
                    x:Name="ErrorPanel">
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12" TextWrapping="Wrap" />
            </Border>

            <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" Margin="0,12,0,0"
                       Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Button x:Name="UpdateButton"
                        Content="Şimdi güncelle"
                        Style="{StaticResource PrimaryButton}"
                        Click="OnUpdateClick"
                        IsDefault="True"
                        MinWidth="150"
                        Margin="0,0,10,0" />
                <Button x:Name="ExitButton"
                        Content="Çıkış"
                        Style="{StaticResource GhostButton}"
                        Click="OnExitClick" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>

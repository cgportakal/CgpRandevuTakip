<Window x:Class="CgpRandevuTakip.Desktop.Views.AppointmentDetailWindow"
        Icon="/Assets/CGPRandevuTakip.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Görüşme detayı"
        Width="720"
        Height="680"
        MinWidth="640"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Görüşme detayı" Style="{StaticResource MutedText}" FontSize="12" />
                <TextBlock Text="{Binding Detail.PersonFullName}"
                           Style="{StaticResource PageTitle}"
                           FontSize="24"
                           Margin="0,2,0,0" />
                <TextBlock Text="{Binding Detail.PhoneE164}"
                           Style="{StaticResource MutedText}"
                           FontWeight="SemiBold"
                           Margin="0,3,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Border CornerRadius="6" Padding="12,5" HorizontalAlignment="Right">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Detail.StatusText}" Value="Tamamlandı">
                                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Detail.StatusText}" Value="Gelmedi">
                                    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Detail.StatusText}" Value="İptal">
                                    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Detail.StatusText}" Value="Ertelendi">
                                    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Detail.StatusText}" FontSize="12" FontWeight="SemiBold" />
                </Border>
                <TextBlock Text="{Binding Detail.DateLabel}"
                           Style="{StaticResource MutedText}"
                           HorizontalAlignment="Right"
                           Margin="0,8,0,0" />
                <TextBlock Text="{Binding Detail.TimeRangeLabel}"
                           FontWeight="SemiBold"
                           FontSize="14"
                           HorizontalAlignment="Right" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="{DynamicResource DangerSoftBrush}"
                        BorderBrush="{DynamicResource DangerBrush}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="12,10"
                        Margin="0,0,0,14"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource DangerBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,14">
                            <TextBlock Text="TARİH" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding Detail.DateLabel}" FontWeight="SemiBold" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,14">
                            <TextBlock Text="SAAT VE SÜRE" Style="{StaticResource LabelText}" />
                            <TextBlock FontWeight="SemiBold">
                                <Run Text="{Binding Detail.TimeRangeLabel, Mode=OneWay}" />
                                <Run Text="·" Foreground="{DynamicResource TextMutedBrush}" />
                                <Run Text="{Binding Detail.DurationMinutes, Mode=OneWay}" />
                                <Run Text="dk" />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,14">
                            <TextBlock Text="GÖRÜŞMECİ" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding Detail.HostName}" FontWeight="SemiBold" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,14">
                            <TextBlock Text="YÖNTEM" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding Detail.MethodText}" FontWeight="SemiBold" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="KATEGORİ" Style="{StaticResource LabelText}" />
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="10" CornerRadius="5"
                                        Margin="0,0,8,0"
                                        Background="{Binding Detail.CategoryColorHex, Converter={StaticResource HexToBrush}}" />
                                <TextBlock Text="{Binding Detail.CategoryName}" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1">
                            <TextBlock Text="ÖĞRENCİ" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding StudentText}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Açıklama" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding DescriptionText}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Hatırlatıcılar" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding ReminderText}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Görüşme sonucu" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding OutcomeTitle}"
                                           FontWeight="SemiBold"
                                           Margin="0,-4,0,0" />
                                <TextBlock Text="{Binding OutcomeClosedText}"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Sonuç gir"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding EnterOutcomeCommand}"
                                    VerticalAlignment="Top"
                                    Padding="14,7"
                                    Visibility="{Binding CanEnterOutcome, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>

                        <Border Style="{StaticResource SoftCard}"
                                Margin="0,14,0,0"
                                Visibility="{Binding Detail.HasOutcome, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="KATILIM" Style="{StaticResource LabelText}" />
                                        <TextBlock Text="{Binding Detail.Outcome.AttendanceText}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="TEKRAR" Style="{StaticResource LabelText}" />
                                        <TextBlock Text="{Binding Detail.Outcome.RepeatText}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="DEĞERLENDİRME" Style="{StaticResource LabelText}" Margin="0,12,0,4" />
                                <TextBlock Text="{Binding Detail.Outcome.SummaryText}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />

                                <TextBlock Text="GÖRÜŞME SONRASI AÇIKLAMA" Style="{StaticResource LabelText}" Margin="0,12,0,4" />
                                <TextBlock Text="{Binding Detail.Outcome.PostNotesText}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Henüz sonuç girilmedi. Görüşme sonrası katılım ve değerlendirme bilgisini ekleyin."
                                   Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"
                                   Visibility="{Binding Detail.HasOutcome, Converter={StaticResource InverseBoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SoftCard}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="KAYIT BİLGİSİ" Style="{StaticResource LabelText}" />
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0">
                            <Run Text="Oluşturuldu:" />
                            <Run Text="{Binding Detail.CreatedAtLocal, Mode=OneWay, StringFormat={}{0:dd/MM/yyyy HH:mm}}" />
                            <Run Text=" · Güncellendi:" />
                            <Run Text="{Binding Detail.UpdatedAtLocal, Mode=OneWay, StringFormat={}{0:dd/MM/yyyy HH:mm}}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Tekrar randevu oluştur"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding RepeatCommand}"
                        Margin="0,0,8,0"
                        Visibility="{Binding CanRepeat, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="WhatsApp'tan gönder"
                        Style="{StaticResource SubtleButton}"
                        Command="{Binding ShareCommand}"
                        Margin="0,0,8,0"
                        Visibility="{Binding CanShare, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Düzenle"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding EditCommand}"
                        Margin="0,0,8,0"
                        Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Sil"
                        Style="{StaticResource DangerButton}"
                        Command="{Binding DeleteCommand}"
                        Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <Button Content="Kapat"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right"
                    MinWidth="110" />
        </Grid>
    </Grid>
</Window>

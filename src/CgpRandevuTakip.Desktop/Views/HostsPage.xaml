<UserControl x:Class="CgpRandevuTakip.Desktop.Views.HostsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:enums="clr-namespace:CgpRandevuTakip.Domain.Enums;assembly=CgpRandevuTakip.Domain"
             Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Görüşmeciler" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="Görüşme yapılacak kişileri yönetin. Giriş bilgisi vermeden de görüşmeci oluşturulabilir."
                           Style="{StaticResource MutedText}" Margin="0,4,0,0" />
            </StackPanel>

            <WrapPanel Grid.Column="1" VerticalAlignment="Center"
                       Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}">
                <Button Content="Yeni görüşmeci"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding NewHostCommand}"
                        Margin="0,0,8,0" />
                <Button Content="Düzenle"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding EditSelectedCommand}"
                        Margin="0,0,8,0" />
                <Button Content="{Binding ToggleActiveLabel}"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ToggleActiveCommand}" />
            </WrapPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                <DataGrid ItemsSource="{Binding Hosts}"
                          SelectedItem="{Binding SelectedHost, Mode=TwoWay}"
                          CanUserSortColumns="True"
                          BorderThickness="0"
                          Background="Transparent"
                          AlternatingRowBackground="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="AD SOYAD" Binding="{Binding DisplayName}" Width="*" MinWidth="150" />

                        <DataGridTemplateColumn Header="ROL" Width="84" SortMemberPath="Role">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Görüşmeci" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Role}" Value="{x:Static enums:UserRole.Admin}">
                                                        <Setter Property="Text" Value="Yönetici" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Role}" Value="{x:Static enums:UserRole.Secretary}">
                                                        <Setter Property="Text" Value="Sekreter" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="KULLANICI ADI" Binding="{Binding Username}" Width="118" />

                        <DataGridTextColumn Header="GÖRÜŞME" Binding="{Binding AppointmentCount}" Width="68" />

                        <DataGridTemplateColumn Header="GİRİŞ" Width="64" SortMemberPath="IsLoginEnabled">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="9,3" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLoginEnabled}" Value="False">
                                                        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Var" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLoginEnabled}" Value="False">
                                                            <Setter Property="Text" Value="Yok" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="DURUM" Width="70" SortMemberPath="IsActive">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="9,3" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Aktif" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Text" Value="Pasif" />
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding SelectedSummary}" Style="{StaticResource MutedText}"
                               Margin="0,-6,0,16" />

                    <StackPanel Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Ad soyad" Style="{StaticResource LabelText}" />
                        <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"
                                 AutomationProperties.Name="Görüşmeci ad soyad" />

                        <CheckBox Content="Bu kişi uygulamaya giriş yapabilsin"
                                  IsChecked="{Binding LoginEnabled}"
                                  Margin="0,16,0,0"
                                  Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibility}}" />

                        <StackPanel Visibility="{Binding ShowLoginFields, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Kullanıcı adı" Style="{StaticResource LabelText}" Margin="0,14,0,6" />
                            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" MaxLength="32"
                                     AutomationProperties.Name="Görüşmeci kullanıcı adı" />

                            <TextBlock Text="Şifre" Style="{StaticResource LabelText}" Margin="0,14,0,6" />
                            <PasswordBox x:Name="PasswordBox" PasswordChanged="OnPasswordChanged"
                                         AutomationProperties.Name="Görüşmeci şifre" />

                            <TextBlock Text="Şifre (tekrar)" Style="{StaticResource LabelText}" Margin="0,14,0,6" />
                            <PasswordBox x:Name="ConfirmPasswordBox" PasswordChanged="OnConfirmPasswordChanged"
                                         AutomationProperties.Name="Görüşmeci şifre tekrar" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Kullanıcı adı" Style="{StaticResource LabelText}" Margin="0,14,0,6" />
                            <TextBox Text="{Binding Username}" IsReadOnly="True" />
                            <TextBlock Text="Kullanıcı adı ve şifre bu ekrandan değiştirilemez."
                                       Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                        </StackPanel>

                        <CheckBox Content="Aktif (yeni görüşmelerde seçilebilir)"
                                  IsChecked="{Binding IsActive}"
                                  Margin="0,16,0,0"
                                  Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" />

                        <Border Background="{DynamicResource DangerSoftBrush}"
                                BorderBrush="{DynamicResource DangerBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="12,10"
                                Margin="0,16,0,0"
                                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="{DynamicResource DangerBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="Kaydet"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SaveCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="Vazgeç"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding NewHostCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <Border Background="{DynamicResource AccentSoftBrush}"
                            CornerRadius="10"
                            Padding="14"
                            Visibility="{Binding CanManage, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="Görüşmeci listesini yalnızca yönetici düzenleyebilir. Mevcut kayıtları görüntüleyebilirsiniz."
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource SuccessBrush}"
                   FontSize="12"
                   Margin="2,12,0,0"
                   Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
    </Grid>
</UserControl>

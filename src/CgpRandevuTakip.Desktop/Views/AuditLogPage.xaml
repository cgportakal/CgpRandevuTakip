<UserControl x:Class="CgpRandevuTakip.Desktop.Views.AuditLogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Denetim Kaydı" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="Giriş, görüşme, ayar, yedekleme ve kullanıcı işlemlerinin salt-okunur kaydı."
                           Style="{StaticResource MutedText}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Yenile"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding LoadCommand}"
                    VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Kullanıcı" Style="{StaticResource LabelText}" />
                    <ComboBox ItemsSource="{Binding UserFilters}"
                              SelectedItem="{Binding SelectedUserFilter, Mode=TwoWay}"
                              DisplayMemberPath="Label"
                              AutomationProperties.Name="Denetim kullanıcı filtresi" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="İşlem" Style="{StaticResource LabelText}" />
                    <ComboBox ItemsSource="{Binding ActionFilters}"
                              SelectedItem="{Binding SelectedActionFilter, Mode=TwoWay}"
                              DisplayMemberPath="Label"
                              AutomationProperties.Name="Denetim işlem filtresi" />
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="Başlangıç" Style="{StaticResource LabelText}" />
                    <DatePicker SelectedDate="{Binding FromDate}"
                                AutomationProperties.Name="Denetim başlangıç tarihi" />
                </StackPanel>

                <StackPanel Grid.Column="6">
                    <TextBlock Text="Bitiş" Style="{StaticResource LabelText}" />
                    <DatePicker SelectedDate="{Binding ToDate}"
                                AutomationProperties.Name="Denetim bitiş tarihi" />
                </StackPanel>

                <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Filtrele"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding ApplyFiltersCommand}"
                            Margin="0,0,8,0" />
                    <Button Content="Temizle"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding ClearFiltersCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="2,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding SummaryText}"
                           Style="{StaticResource MutedText}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Text="Sayfa boyutu" Style="{StaticResource MutedText}" Margin="18,0,6,0" />
                <ComboBox ItemsSource="{Binding PageSizeOptions}"
                          SelectedItem="{Binding SelectedPageSize, Mode=TwoWay}"
                          Width="70"
                          AutomationProperties.Name="Sayfa boyutu" />
                <Button Content="◀ Önceki"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding PreviousPageCommand}"
                        Margin="14,0,6,0"
                        Padding="10,5" />
                <Button Content="Sonraki ▶"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding NextPageCommand}"
                        Padding="10,5" />
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource DangerBrush}"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <Grid>
                <DataGrid ItemsSource="{Binding Entries}"
                          CanUserSortColumns="True"
                          BorderThickness="0"
                          Background="Transparent"
                          IsReadOnly="True"
                          AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="TARİH" Binding="{Binding CreatedAtText}"
                                            SortMemberPath="CreatedAtLocal" Width="150" />
                        <DataGridTextColumn Header="KULLANICI" Binding="{Binding UserName}"
                                            SortMemberPath="UserName" Width="160" />
                        <DataGridTextColumn Header="İŞLEM" Binding="{Binding ActionText}"
                                            SortMemberPath="ActionText" Width="205" />
                        <DataGridTextColumn Header="VARLIK" Binding="{Binding EntityText}"
                                            SortMemberPath="EntityType" Width="130" />
                        <DataGridTextColumn Header="KAYIT NO" Binding="{Binding EntityIdText}"
                                            SortMemberPath="EntityId" Width="200" />
                        <DataGridTemplateColumn Header="DETAY" Width="*" SortMemberPath="DetailsText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DetailsText}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding DetailsText}"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Background="{DynamicResource SurfaceBrush}"
                        Visibility="{Binding HasEntries, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                        <TextBlock Text="📋"
                                   FontSize="40"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{Binding SummaryText}"
                                   Style="{StaticResource MutedText}"
                                   TextAlignment="Center"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>

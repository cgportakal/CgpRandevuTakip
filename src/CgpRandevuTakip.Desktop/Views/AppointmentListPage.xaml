<UserControl x:Class="CgpRandevuTakip.Desktop.Views.AppointmentListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:enums="clr-namespace:CgpRandevuTakip.Domain.Enums;assembly=CgpRandevuTakip.Domain"
             Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tarih gezinme ve arama -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="◀"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding PreviousDayCommand}"
                            Padding="12,8"
                            Margin="0,0,8,0"
                            ToolTip="Önceki gün"
                            AutomationProperties.Name="Önceki gün" />
                    <DatePicker SelectedDate="{Binding SelectedDate}"
                                Width="190"
                                MinHeight="38"
                                AutomationProperties.Name="Tarih seç"
                                ToolTip="Listelenecek tarihi seç" />
                    <Button Content="▶"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding NextDayCommand}"
                            Padding="12,8"
                            Margin="8,0,8,0"
                            ToolTip="Sonraki gün"
                            AutomationProperties.Name="Sonraki gün" />
                    <Button Content="Bugün"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding GoTodayCommand}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="+  Yeni görüşme"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding OpenNewCommand}"
                        VerticalAlignment="Center"
                        Visibility="{Binding CanCreate, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="220" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,16,0">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="38"
                             Padding="14,8"
                             ToolTip="Ad, telefon, kategori veya görüşmeci ara"
                             AutomationProperties.Name="Görüşme ara" />
                    <TextBlock Text="🔍  Ad, telefon, kategori veya görüşmeci ara"
                               Style="{StaticResource MutedText}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Margin="14,0,14,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding SearchText, Converter={StaticResource StringToVisibilityInverse}}" />
                </Grid>

                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding CategoryFilters}"
                              SelectedItem="{Binding SelectedCategoryFilter}"
                              DisplayMemberPath="Label"
                              Width="160"
                              Margin="0,0,8,0"
                              AutomationProperties.Name="Kategori filtresi" />
                    <ComboBox ItemsSource="{Binding HostFilters}"
                              SelectedItem="{Binding SelectedHostFilter}"
                              DisplayMemberPath="Label"
                              Width="150"
                              Margin="0,0,8,0"
                              Visibility="{Binding CanFilterHosts, Converter={StaticResource BoolToVisibility}}"
                              AutomationProperties.Name="Görüşmeci filtresi" />
                    <ComboBox ItemsSource="{Binding StatusFilters}"
                              SelectedItem="{Binding SelectedStatusFilter}"
                              DisplayMemberPath="Label"
                              Width="140"
                              Margin="0,0,8,0"
                              AutomationProperties.Name="Durum filtresi" />
                    <Button Content="Temizle"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding ClearFiltersCommand}" />
                </WrapPanel>
            </Grid>
        </StackPanel>

        <!-- Özet -->
        <Grid Grid.Row="1" Margin="2,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding SummaryText}"
                           Style="{StaticResource MutedText}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Visibility="{Binding HasSelectedRows, Converter={StaticResource InverseBoolToVisibility}}" />

                <TextBlock Text="{Binding SelectionText}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center"
                           Visibility="{Binding HasSelectedRows, Converter={StaticResource BoolToVisibility}}" />

                <Button Content="Seçimi temizle"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding ClearSelectionCommand}"
                        Padding="10,5"
                        Margin="12,0,0,0"
                        Visibility="{Binding HasSelectedRows, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Detay"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding OpenDetailCommand}"
                        Padding="14,7"
                        Margin="0,0,8,0" />
                <Button Content="Dışa aktar"
                        Style="{StaticResource SecondaryButton}"
                        Click="OnExportClick"
                        Padding="14,7"
                        Margin="0,0,8,0"
                        ToolTip="Excel, CSV veya PDF olarak dışa aktar"
                        Visibility="{Binding CanExport, Converter={StaticResource BoolToVisibility}}">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="ExportMenu">
                            <MenuItem Header="Excel (.xlsx)" Command="{Binding ExportExcelCommand}" />
                            <MenuItem Header="CSV (.csv)" Command="{Binding ExportCsvCommand}" />
                            <Separator />
                            <MenuItem Header="PDF (.pdf)" Command="{Binding ExportPdfCommand}" />
                            <MenuItem Header="Yazdır" Command="{Binding PrintCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Content="Paylaş"
                        Style="{StaticResource SubtleButton}"
                        Command="{Binding ShareDailyListCommand}"
                        Padding="14,7"
                        Margin="0,0,8,0"
                        Visibility="{Binding CanShareDailyList, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Silinenler"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding OpenDeletedCommand}"
                        Padding="14,7"
                        Margin="0,0,8,0"
                        Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Taşı"
                        Style="{StaticResource SubtleButton}"
                        Command="{Binding MoveSelectedCommand}"
                        Padding="14,7"
                        Margin="0,0,8,0"
                        ToolTip="Seçili görüşmeleri başka bir tarihe taşı"
                        Visibility="{Binding CanCreate, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Sil"
                        Style="{StaticResource DangerButton}"
                        Command="{Binding DeleteSelectedCommand}"
                        Padding="14,7"
                        ToolTip="Seçili görüşmeleri sil"
                        Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Grid>

        <!-- Sıradaki görüşme -->
        <Border Grid.Row="2"
                Background="{DynamicResource AccentSoftBrush}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,10"
                Margin="0,0,0,12"
                Visibility="{Binding HasNextAppointment, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SIRADAKİ GÖRÜŞME" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding NextAppointmentText}"
                               FontWeight="SemiBold"
                               FontSize="13" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Aç"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding OpenNextCommand}"
                        Padding="16,7"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Liste -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <Grid>
                <DataGrid x:Name="AppointmentGrid"
                          ItemsSource="{Binding Appointments}"
                          SelectedItem="{Binding SelectedAppointment, Mode=TwoWay}"
                          MouseDoubleClick="OnRowDoubleClick"
                          CanUserSortColumns="True"
                          BorderThickness="0"
                          Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn x:Name="SelectionColumn" Width="40" CanUserSort="False">
                            <DataGridTemplateColumn.Header>
                                <CheckBox x:Name="SelectAllCheckBox"
                                          Checked="OnSelectAllChanged"
                                          Unchecked="OnSelectAllChanged"
                                          Style="{StaticResource GridSelectCheckBox}"
                                          ToolTip="Tümünü seç / seçimi kaldır"
                                          AutomationProperties.Name="Tümünü seç" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource GridSelectCheckBox}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ToolTip="Görüşmeyi seç"
                                              AutomationProperties.Name="Görüşmeyi seç" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="GÖRÜŞMECİ" Binding="{Binding HostName}"
                                            SortMemberPath="HostName" Width="165" />

                        <DataGridTemplateColumn Header="KİŞİ" Width="*" SortMemberPath="PersonFullName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PersonFullName}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding PhoneE164}"
                                                   Style="{StaticResource MutedText}"
                                                   FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="SAAT" Width="92" SortMemberPath="StartsAtLocal">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TimeLabel}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14" />
                                        <TextBlock Text="{Binding EndTimeLabel}"
                                                   Style="{StaticResource MutedText}"
                                                   FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="KONU" Width="170" SortMemberPath="CategoryName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="10" Height="10" CornerRadius="5"
                                                Margin="0,0,8,0"
                                                Background="{Binding CategoryColorHex, Converter={StaticResource HexToBrush}}" />
                                        <TextBlock Text="{Binding CategoryName}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="YÖNTEM" Binding="{Binding MethodText}"
                                            SortMemberPath="MethodText" Width="100" />

                        <DataGridTemplateColumn Header="DURUM" Width="130" SortMemberPath="StatusText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border CornerRadius="6" Padding="9,3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:AppointmentStatus.Completed}">
                                                            <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:AppointmentStatus.NoShow}">
                                                            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:AppointmentStatus.Cancelled}">
                                                            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:AppointmentStatus.Postponed}">
                                                            <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Text="gecikme"
                                                   Style="{StaticResource MutedText}"
                                                   FontSize="10"
                                                   Margin="6,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsOverdue, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Background="{DynamicResource SurfaceBrush}"
                        Visibility="{Binding HasAppointments, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                        <TextBlock Text="🗓"
                                   FontSize="40"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{Binding EmptyMessage}"
                                   Style="{StaticResource MutedText}"
                                   TextAlignment="Center"
                                   Margin="0,12,0,0" />
                        <Button Content="+  Yeni görüşme"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding OpenNewCommand}"
                                HorizontalAlignment="Center"
                                Margin="0,18,0,0"
                                Visibility="{Binding CanCreate, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

    </Grid>
</UserControl>

<UserControl x:Class="CgpRandevuTakip.Desktop.Views.BackupsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Yedekleme" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="Seçtiğiniz bölümler tek ZIP dosyasında saklanır; geri yüklemede istediğiniz bölümü seçebilirsiniz."
                           Style="{StaticResource MutedText}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Klasörü aç"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding OpenFolderCommand}"
                        Margin="0,0,8,0" />
                <Button Content="Şimdi yedekle"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding CreateBackupCommand}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding LastBackupText}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding BackupDirectory}"
                               Style="{StaticResource MutedText}"
                               Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding AutoBackupText}"
                               Style="{StaticResource MutedText}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="Seçili yedeği doğrula"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ValidateSelectedCommand}"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Stretch" />
                    <Button Content="Geri yükle…"
                            Style="{StaticResource DangerButton}"
                            Command="{Binding RestoreSelectedCommand}"
                            HorizontalAlignment="Stretch" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Margin="2,0,0,10">
            <Grid>
                <TextBlock Text="{Binding SummaryText}"
                           Style="{StaticResource MutedText}"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource DangerBrush}"
                           HorizontalAlignment="Right"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" />
            </Grid>

            <Border Style="{StaticResource Card}"
                    Margin="0,10,0,0"
                    Padding="14,12"
                    Visibility="{Binding HasInspection, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding InspectionSummaryText}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding InspectionDatesText}"
                               Style="{StaticResource MutedText}"
                               Margin="0,3,0,0" />
                    <TextBlock Text="{Binding InspectionSettingsText}"
                               Style="{StaticResource MutedText}"
                               Margin="0,3,0,0" />
                    <TextBlock Text="{Binding InspectionWarningsText}"
                               Foreground="{DynamicResource DangerBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"
                               Visibility="{Binding InspectionWarningsText, Converter={StaticResource StringToVisibility}}" />
                </StackPanel>
            </Border>

            <TextBlock Text="Yedek içeriği inceleniyor…"
                       Style="{StaticResource MutedText}"
                       Margin="0,6,0,0"
                       Visibility="{Binding IsInspecting, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <Grid>
                <DataGrid ItemsSource="{Binding Backups}"
                          SelectedItem="{Binding SelectedBackup, Mode=TwoWay}"
                          CanUserSortColumns="True"
                          BorderThickness="0"
                          Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="DOSYA" Binding="{Binding FileName}"
                                            SortMemberPath="FileName" Width="*" ElementStyle="{StaticResource DataGridCellText}" />
                        <DataGridTextColumn Header="TARİH" Binding="{Binding CreatedAtText}"
                                            SortMemberPath="CreatedAtLocal" Width="150" ElementStyle="{StaticResource DataGridCellText}" />
                        <DataGridTextColumn Header="BOYUT" Binding="{Binding SizeText}"
                                            SortMemberPath="SizeBytes" Width="100" ElementStyle="{StaticResource DataGridCellText}" />
                        <DataGridTextColumn Header="KAYNAK" Binding="{Binding SourceText}"
                                            SortMemberPath="Source" Width="110" ElementStyle="{StaticResource DataGridCellText}" />
                        <DataGridTextColumn Header="ŞİFRE" Binding="{Binding EncryptionText}"
                                            SortMemberPath="IsEncrypted" Width="90" ElementStyle="{StaticResource DataGridCellText}" />
                        <DataGridTextColumn Header="DOĞRULAMA" Binding="{Binding VerificationText}"
                                            SortMemberPath="IsVerified" Width="120" ElementStyle="{StaticResource DataGridCellText}" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border Background="{DynamicResource SurfaceBrush}"
                        Visibility="{Binding HasBackups, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430">
                        <TextBlock Text="🗄"
                                   FontSize="40"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{Binding SummaryText}"
                                   Style="{StaticResource MutedText}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0" />
                        <Button Content="Şimdi yedekle"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding CreateBackupCommand}"
                                HorizontalAlignment="Center"
                                Margin="0,18,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<Window x:Class="CgpRandevuTakip.Desktop.Views.AppointmentEditorWindow"
        Icon="/Assets/CGPRandevuTakip.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="860"
        Height="720"
        MinWidth="760"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" FontSize="22" />
            <TextBlock Text="Ad, soyad, telefon, tarih/saat, görüşmeci ve kategori zorunludur."
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sol kolon: kişi ve görüşme -->
                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Görüşülecek kişi" Style="{StaticResource SectionTitle}" />

                            <TextBlock Text="Ad *" Style="{StaticResource LabelText}" />
                            <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"
                                     AutomationProperties.Name="Ad" />

                            <TextBlock Text="Soyad *" Style="{StaticResource LabelText}" Margin="0,12,0,6" />
                            <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"
                                     AutomationProperties.Name="Soyad" />

                            <TextBlock Text="Telefon *" Style="{StaticResource LabelText}" Margin="0,12,0,6" />
                            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" MaxLength="24"
                                     AutomationProperties.Name="Telefon" />
                            <TextBlock Text="Örnek: 0532 123 45 67 · +905321234567 olarak saklanır."
                                       Style="{StaticResource MutedText}" Margin="0,5,0,0" />

                            <Border Style="{StaticResource Divider}" />

                            <TextBlock Text="Görüşme" Style="{StaticResource SectionTitle}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Tarih *" Style="{StaticResource LabelText}" />
                                    <DatePicker SelectedDate="{Binding Date}" MinHeight="40"
                                                AutomationProperties.Name="Tarih" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Saat *" Style="{StaticResource LabelText}" />
                                    <ComboBox ItemsSource="{Binding TimeOptions}"
                                              SelectedItem="{Binding TimeText, Mode=TwoWay}"
                                              IsTextSearchEnabled="True"
                                              AutomationProperties.Name="Saat" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Süre" Style="{StaticResource LabelText}" Margin="0,12,0,6" />
                            <ComboBox ItemsSource="{Binding Durations}"
                                      SelectedItem="{Binding SelectedDuration}"
                                      DisplayMemberPath="Label"
                                      AutomationProperties.Name="Süre" />

                            <TextBlock Text="Görüşmeci *" Style="{StaticResource LabelText}" Margin="0,12,0,6" />
                            <ComboBox ItemsSource="{Binding Hosts}"
                                      SelectedItem="{Binding SelectedHost}"
                                      DisplayMemberPath="DisplayName"
                                      AutomationProperties.Name="Görüşmeci" />

                            <TextBlock Text="Oda" Style="{StaticResource LabelText}" Margin="0,12,0,6" />
                            <ComboBox ItemsSource="{Binding Rooms}"
                                      SelectedItem="{Binding SelectedRoom}"
                                      DisplayMemberPath="DisplayName"
                                      AutomationProperties.Name="Oda" />
                            <TextBlock Text="Yüz yüze görüşmede oda zorunludur."
                                       Style="{StaticResource MutedText}" Margin="0,5,0,0" />

                            <TextBlock Text="Katılımcılar" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
                            <TextBlock Text="Birincil görüşmeci dışında görüşmeye katılanları seçin."
                                       Style="{StaticResource MutedText}" Margin="0,-4,0,6" />
                            <ItemsControl ItemsSource="{Binding ParticipantHosts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding DisplayName}"
                                                  IsChecked="{Binding IsSelected}"
                                                  Margin="0,0,0,4" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Kategori *" Style="{StaticResource LabelText}" Margin="0,12,0,6" />
                            <ComboBox ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding SelectedCategory}"
                                      DisplayMemberPath="Name"
                                      AutomationProperties.Name="Kategori" />

                            <TextBlock Text="Yöntem *" Style="{StaticResource LabelText}" Margin="0,12,0,6" />
                            <ComboBox ItemsSource="{Binding Methods}"
                                      SelectedItem="{Binding SelectedMethod}"
                                      DisplayMemberPath="Label"
                                      AutomationProperties.Name="Yöntem" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Sağ kolon: ek bilgiler ve hatırlatıcılar -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Ek bilgiler" Style="{StaticResource SectionTitle}" />

                            <TextBlock Text="Açıklama" Style="{StaticResource LabelText}" />
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="4000"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="92"
                                     VerticalContentAlignment="Top"
                                     AutomationProperties.Name="Açıklama" />

                            <TextBlock Text="Öğrenci adı (opsiyonel)" Style="{StaticResource LabelText}" Margin="0,12,0,6" />
                            <TextBox Text="{Binding StudentFirstName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"
                                     AutomationProperties.Name="Öğrenci adı" />

                            <TextBlock Text="Öğrenci soyadı (opsiyonel)" Style="{StaticResource LabelText}" Margin="0,12,0,6" />
                            <TextBox Text="{Binding StudentLastName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"
                                     AutomationProperties.Name="Öğrenci soyadı" />

                            <TextBlock Text="Ek misafirler" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
                            <TextBlock Text="Aynı görüşmeye birden fazla misafir ekleyebilirsiniz."
                                       Style="{StaticResource MutedText}" Margin="0,-4,0,6" />
                            <ItemsControl ItemsSource="{Binding Guests}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"
                                                     MaxLength="100" AutomationProperties.Name="Misafir adı" />
                                            <TextBox Grid.Column="2" Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"
                                                     MaxLength="100" AutomationProperties.Name="Misafir soyadı" />
                                            <TextBox Grid.Column="4" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                                     MaxLength="24" AutomationProperties.Name="Misafir telefonu" />
                                            <Button Grid.Column="5" Content="Kaldır" Margin="6,0,0,0"
                                                    Style="{StaticResource GhostButton}"
                                                    Command="{Binding DataContext.RemoveGuestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="+ Misafir ekle" Command="{Binding AddGuestCommand}"
                                    Style="{StaticResource GhostButton}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Hatırlatıcılar" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Seçim boş bırakılabilir; bu durumda hatırlatma gönderilmez."
                                       Style="{StaticResource MutedText}" Margin="0,-6,0,12" />

                            <CheckBox Content="1 gün önce" IsChecked="{Binding ReminderOneDay}" Margin="0,0,0,10" />
                            <CheckBox Content="1 saat önce" IsChecked="{Binding ReminderOneHour}" Margin="0,0,0,10" />
                            <CheckBox Content="30 dakika önce (varsayılan)" IsChecked="{Binding ReminderThirtyMinutes}" Margin="0,0,0,10" />

                            <CheckBox Content="Özel hatırlatıcı" IsChecked="{Binding ReminderCustom}" Margin="0,0,0,8" />
                            <Grid IsEnabled="{Binding ReminderCustom}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Saat önce" Style="{StaticResource MutedText}" />
                                    <ComboBox ItemsSource="{Binding ReminderHourOptions}"
                                              SelectedItem="{Binding ReminderCustomHours}"
                                              AutomationProperties.Name="Özel hatırlatıcı saat" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Dakika önce" Style="{StaticResource MutedText}" />
                                    <ComboBox ItemsSource="{Binding ReminderMinuteOptions}"
                                              SelectedItem="{Binding ReminderCustomMinutes}"
                                              AutomationProperties.Name="Özel hatırlatıcı dakika" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                            Visibility="{Binding ShowSeriesPanel, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Tekrarlayan seri" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Aynı görüşmeyi haftalık, 2 haftada bir veya aylık planlayın. Çakışan veya geçmiş tarihler atlanır."
                                       Style="{StaticResource MutedText}" Margin="0,-6,0,12" TextWrapping="Wrap" />

                            <CheckBox Content="Bu görüşmeyi seri olarak planla"
                                      IsChecked="{Binding SeriesEnabled}"
                                      Margin="0,0,0,10" />

                            <Grid IsEnabled="{Binding SeriesEnabled}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Sıklık" Style="{StaticResource LabelText}" />
                                    <ComboBox ItemsSource="{Binding SeriesFrequencyOptions}"
                                              SelectedItem="{Binding SelectedSeriesFrequency}"
                                              DisplayMemberPath="Label"
                                              AutomationProperties.Name="Seri sıklığı" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Kayıt sayısı" Style="{StaticResource LabelText}" />
                                    <ComboBox ItemsSource="{Binding SeriesCountOptions}"
                                              SelectedItem="{Binding SeriesCount}"
                                              AutomationProperties.Name="Seri kayıt sayısı" />
                                </StackPanel>
                            </Grid>

                            <Button Content="Önizle"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding PreviewSeriesCommand}"
                                    IsEnabled="{Binding SeriesEnabled}"
                                    HorizontalAlignment="Left"
                                    Margin="0,10,0,0" />

                            <TextBlock Text="{Binding SeriesSummary}"
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />

                            <ItemsControl ItemsSource="{Binding SeriesPreview}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding DateText}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding TimeText}"
                                                       Style="{StaticResource MutedText}"
                                                       Margin="10,0,0,0" />

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding StateText}"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="110">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding WillCreate}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                            Visibility="{Binding IsEdit, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Görüşme sonucu" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding OutcomeStatusText}"
                                       FontWeight="SemiBold"
                                       Margin="0,-4,0,0" />
                            <TextBlock Text="{Binding OutcomeSummary}"
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,12"
                                       Visibility="{Binding HasOutcome, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="Sonucu gir / düzenle"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding EnterOutcomeCommand}"
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <Border Background="{DynamicResource AccentSoftBrush}"
                    CornerRadius="9"
                    Padding="12,10"
                    Margin="0,0,0,10"
                    Visibility="{Binding WarningMessage, Converter={StaticResource StringToVisibility}}">
                <TextBlock Text="{Binding WarningMessage}"
                           Foreground="{DynamicResource AccentBrush}"
                           FontSize="12"
                           TextWrapping="Wrap" />
            </Border>

            <Border Background="{DynamicResource DangerSoftBrush}"
                    BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="12,10"
                    Margin="0,0,0,10"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource DangerBrush}"
                           FontSize="12"
                           TextWrapping="Wrap" />
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Vazgeç"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding CancelCommand}"
                        IsCancel="True"
                        Margin="0,0,10,0" />
                <Button Content="Kaydet"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveCommand}"
                        IsDefault="True"
                        MinWidth="120" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="CgpRandevuTakip.Desktop.Views.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Oturum kilitli · CGP - Randevu Takip"
        Width="480"
        MinHeight="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center">
            <Border Width="56" Height="56" CornerRadius="16"
                    Background="{DynamicResource AccentSoftBrush}"
                    HorizontalAlignment="Left">
                <TextBlock Text="🔒" FontSize="24"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <TextBlock Text="Oturum kilitli" Style="{StaticResource PageTitle}" FontSize="24" Margin="0,18,0,0" />
            <TextBlock Text="{Binding Message}" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Margin="0,14,0,0" />

            <TextBlock Text="Kullanıcı adı" Style="{StaticResource LabelText}" Margin="0,16,0,6" />
            <TextBox Text="{Binding Username}" IsReadOnly="True"
                     AutomationProperties.Name="Kilitli oturum kullanıcı adı" />

            <TextBlock Text="Şifre" Style="{StaticResource LabelText}" Margin="0,14,0,6" />
            <PasswordBox x:Name="PasswordBox"
                         PasswordChanged="OnPasswordChanged"
                         KeyDown="OnPasswordKeyDown"
                         AutomationProperties.Name="Kilitli oturum şifresi" />

            <Border Background="{DynamicResource DangerSoftBrush}"
                    BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="12,10"
                    Margin="0,14,0,0"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource DangerBrush}"
                           FontSize="12"
                           TextWrapping="Wrap" />
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Button Content="Kilidi aç"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding UnlockCommand}"
                        IsDefault="True"
                        MinWidth="130"
                        Margin="0,0,10,0" />
                <Button Content="Çıkış yap"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding LogoutCommand}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>

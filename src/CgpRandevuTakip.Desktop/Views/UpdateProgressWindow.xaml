<Window x:Class="CgpRandevuTakip.Desktop.Views.UpdateProgressWindow"
        Icon="/Assets/CGPRandevuTakip.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Güncelleme · CGP - Randevu Takip"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Loaded="OnLoaded">
    <Grid Margin="30">
        <StackPanel>
            <TextBlock Text="Güncelleme indiriliyor" Style="{StaticResource PageTitle}" FontSize="22" />
            <TextBlock x:Name="VersionText" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />

            <ProgressBar x:Name="ProgressBar"
                         Height="12"
                         Minimum="0"
                         Maximum="100"
                         Margin="0,22,0,0"
                         Foreground="{DynamicResource AccentBrush}" />

            <TextBlock x:Name="PercentText"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Margin="0,10,0,0"
                       Text="0%" />

            <TextBlock x:Name="DetailText"
                       Style="{StaticResource MutedText}"
                       Margin="0,2,0,0" />

            <TextBlock x:Name="StatusText"
                       Style="{StaticResource MutedText}"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0"
                       Text="Güncelleme hazırlanıyor…" />

            <Border x:Name="ErrorPanel"
                    Background="{DynamicResource DangerSoftBrush}"
                    BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="12,10"
                    Margin="0,14,0,0"
                    Visibility="Collapsed">
                <TextBlock x:Name="ErrorText"
                           Foreground="{DynamicResource DangerBrush}"
                           FontSize="12"
                           TextWrapping="Wrap" />
            </Border>

            <Button x:Name="CloseButton"
                    Content="Kapat"
                    Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Left"
                    MinWidth="110"
                    Margin="0,18,0,0"
                    Visibility="Collapsed"
                    Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>

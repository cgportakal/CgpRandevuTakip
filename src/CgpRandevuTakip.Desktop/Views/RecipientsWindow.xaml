<Window x:Class="CgpRandevuTakip.Desktop.Views.RecipientsWindow"
        Icon="/Assets/CGPRandevuTakip.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alıcı rehberi · CGP - Randevu Takip"
        Width="820"
        Height="560"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="ALICI REHBERİ" Style="{StaticResource LabelText}" />
                <TextBlock Text="Günlük liste alıcıları" Style="{StaticResource PageTitle}" FontSize="24" />
                <TextBlock Text="Yalnızca kurum içi alıcılar ekleyin."
                           Style="{StaticResource MutedText}" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Yeni alıcı" Style="{StaticResource PrimaryButton}"
                        Command="{Binding NewCommand}" Margin="0,0,8,0" />
                <Button Content="Düzenle" Style="{StaticResource SecondaryButton}"
                        Command="{Binding EditSelectedCommand}" Margin="0,0,8,0" />
                <Button Content="{Binding ToggleActiveLabel}" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ToggleActiveCommand}" Margin="0,0,8,0" />
                <Button Content="Kapat" Style="{StaticResource GhostButton}"
                        Command="{Binding CloseCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                <DataGrid ItemsSource="{Binding Recipients}"
                          SelectedItem="{Binding SelectedRecipient, Mode=TwoWay}"
                          BorderThickness="0"
                          Background="Transparent"
                          IsReadOnly="True"
                          AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="AD" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="TELEFON" Binding="{Binding PhoneDisplay}" Width="150" />
                        <DataGridTextColumn Header="ETİKET" Binding="{Binding Tag}" Width="120" />
                        <DataGridTextColumn Header="DURUM" Binding="{Binding IsActive}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionTitle}" />

                    <TextBlock Text="Ad soyad" Style="{StaticResource LabelText}" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Alıcı ad soyad" />

                    <TextBlock Text="Telefon" Style="{StaticResource LabelText}" Margin="0,12,0,6" />
                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Alıcı telefon" />

                    <TextBlock Text="Etiket (opsiyonel)" Style="{StaticResource LabelText}" Margin="0,12,0,6" />
                    <TextBox Text="{Binding Tag, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Alıcı etiket" />

                    <CheckBox Content="Aktif" IsChecked="{Binding IsActive}" Margin="0,14,0,0" />

                    <Border Background="{DynamicResource DangerSoftBrush}"
                            BorderBrush="{DynamicResource DangerBrush}"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="12,10"
                            Margin="0,14,0,0"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{DynamicResource DangerBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Kaydet" Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveCommand}" Margin="0,0,8,0" />
                        <Button Content="Vazgeç" Style="{StaticResource GhostButton}"
                                Command="{Binding NewCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource SuccessBrush}"
                   FontSize="12"
                   Margin="2,12,0,0"
                   Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
    </Grid>
</Window>

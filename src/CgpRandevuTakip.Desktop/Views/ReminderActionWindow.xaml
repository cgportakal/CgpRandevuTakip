<Window x:Class="CgpRandevuTakip.Desktop.Views.ReminderActionWindow"
        Icon="/Assets/CGPRandevuTakip.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hatırlatıcı"
        Width="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        Background="{DynamicResource WindowBackgroundBrush}">
    <StackPanel Margin="26">
        <Border Style="{StaticResource BadgeBorder}" HorizontalAlignment="Left">
            <TextBlock Text="SIRADAKİ GÖRÜŞME" Style="{StaticResource BadgeText}" />
        </Border>

        <TextBlock Text="Sıradaki görüşme yaklaşıyor"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0,16,0,0" />

        <Border Style="{StaticResource SoftCard}" Margin="0,18,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding PersonFullName}" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CategoryName}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding MethodText}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding HostName, StringFormat=Görüşmeci: {0}}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding PhoneE164, StringFormat=Telefon: {0}}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding TimeLabel}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding DateLabel}" Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Text="Ne yapmak istersiniz?" Style="{StaticResource LabelText}" Margin="0,18,0,8" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Grid.Column="0"
                    Content="Sadece kapat"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding DismissCommand}" />
            <Button Grid.Row="0" Grid.Column="2"
                    Content="Görüşmeciye bilgi ver"
                    Style="{StaticResource SubtleButton}"
                    Command="{Binding InformedCommand}" />
            <Button Grid.Row="2" Grid.Column="0"
                    Content="Ulaşılamadı · 10 dk ertele"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding SnoozeCommand}" />
            <Button Grid.Row="2" Grid.Column="2"
                    Content="Ziyaretçi iptal etti"
                    Style="{StaticResource DangerButton}"
                    Command="{Binding VisitorCancelledCommand}" />
        </Grid>

        <Border Background="{DynamicResource DangerSoftBrush}"
                BorderBrush="{DynamicResource DangerBrush}"
                BorderThickness="1"
                CornerRadius="9"
                Padding="12,10"
                Margin="0,14,0,0"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource DangerBrush}"
                       FontSize="12"
                       TextWrapping="Wrap" />
        </Border>
    </StackPanel>
</Window>

<UserControl x:Class="CgpRandevuTakip.Desktop.Views.UsersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Kullanıcılar" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="Yerel hesapları, rolleri ve giriş izinlerini yönetin. Son yönetici korunur."
                           Style="{StaticResource MutedText}" Margin="0,4,0,0" />
            </StackPanel>

            <WrapPanel Grid.Column="1" VerticalAlignment="Center"
                       Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}">
                <Button Content="Yeni kullanıcı"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding NewUserCommand}"
                        Margin="0,0,8,0" />
                <Button Content="Düzenle"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding EditSelectedCommand}"
                        Margin="0,0,8,0" />
                <Button Content="{Binding ToggleActiveLabel}"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ToggleActiveCommand}" />
            </WrapPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                <DataGrid ItemsSource="{Binding Users}"
                          SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                          BorderThickness="0"
                          Background="Transparent"
                          AlternatingRowBackground="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="AD SOYAD" Binding="{Binding DisplayName}" Width="*" MinWidth="150" />
                        <DataGridTextColumn Header="KULLANICI ADI" Binding="{Binding Username}" Width="130" />
                        <DataGridTextColumn Header="ROL" Binding="{Binding RoleText}" Width="92" />
                        <DataGridTextColumn Header="SON GİRİŞ" Binding="{Binding LastLoginText}" Width="126" />

                        <DataGridTemplateColumn Header="DURUM" Width="86">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="9,3" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusText}" Value="Girişsiz">
                                                        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusText}" Value="Pasif">
                                                        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusText}" Value="Girişsiz">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusText}" Value="Pasif">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="620">
                    <StackPanel>
                        <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding SelectedSummary}" Style="{StaticResource MutedText}"
                                   Margin="0,-6,0,16" />

                        <StackPanel Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Ad soyad" Style="{StaticResource LabelText}" />
                            <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"
                                     AutomationProperties.Name="Kullanıcı ad soyad" />

                            <TextBlock Text="E-posta (şifre sıfırlama için)" Style="{StaticResource LabelText}" Margin="0,14,0,6" />
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"
                                     AutomationProperties.Name="Kullanıcı e-posta" />

                            <TextBlock Text="Kullanıcı adı" Style="{StaticResource LabelText}" Margin="0,14,0,6" />
                            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="32"
                                     IsReadOnly="{Binding IsEditing}"
                                     AutomationProperties.Name="Kullanıcı adı" />
                            <TextBlock Text="Kullanıcı adı düzenleme sırasında değiştirilemez."
                                       Style="{StaticResource MutedText}"
                                       Margin="0,5,0,0"
                                       Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock Text="Rol" Style="{StaticResource LabelText}" Margin="0,14,0,6" />
                            <ComboBox ItemsSource="{Binding RoleOptions}"
                                      SelectedItem="{Binding SelectedRole}"
                                      DisplayMemberPath="Label"
                                      AutomationProperties.Name="Kullanıcı rolü" />

                            <CheckBox Content="Giriş yapabilsin"
                                      IsChecked="{Binding IsLoginEnabled}"
                                      IsEnabled="{Binding IsLoginToggleEnabled}"
                                      Margin="0,14,0,0" />

                            <CheckBox Content="Aktif"
                                      IsChecked="{Binding IsActive}"
                                      Margin="0,10,0,0" />

                            <StackPanel Visibility="{Binding ShowNewPasswordFields, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Şifre" Style="{StaticResource LabelText}" Margin="0,14,0,6" />
                                <PasswordBox x:Name="PasswordBox" PasswordChanged="OnPasswordChanged"
                                             AutomationProperties.Name="Kullanıcı şifre" />

                                <TextBlock Text="Şifre (tekrar)" Style="{StaticResource LabelText}" Margin="0,12,0,6" />
                                <PasswordBox x:Name="ConfirmPasswordBox" PasswordChanged="OnConfirmPasswordChanged"
                                             AutomationProperties.Name="Kullanıcı şifre tekrar" />
                            </StackPanel>

                            <Border Background="{DynamicResource DangerSoftBrush}"
                                    BorderBrush="{DynamicResource DangerBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="12,10"
                                    Margin="0,16,0,0"
                                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                                <TextBlock Text="{Binding ErrorMessage}"
                                           Foreground="{DynamicResource DangerBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Button Content="Kaydet"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding SaveCommand}"
                                        Margin="0,0,8,0" />
                                <Button Content="Vazgeç"
                                        Style="{StaticResource GhostButton}"
                                        Command="{Binding NewUserCommand}" />
                            </StackPanel>

                            <Border Style="{StaticResource Divider}" />

                            <StackPanel Visibility="{Binding ShowResetPasswordFields, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Şifre sıfırla" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Yönetici, kullanıcının şifresini mevcut şifreyi bilmeden yenileyebilir."
                                           Style="{StaticResource MutedText}" Margin="0,-6,0,12" />

                                <TextBlock Text="Yeni şifre" Style="{StaticResource LabelText}" />
                                <PasswordBox x:Name="ResetPasswordBox" PasswordChanged="OnResetPasswordChanged"
                                             AutomationProperties.Name="Yeni şifre" />

                                <TextBlock Text="Yeni şifre (tekrar)" Style="{StaticResource LabelText}" Margin="0,12,0,6" />
                                <PasswordBox x:Name="ResetConfirmPasswordBox" PasswordChanged="OnResetConfirmPasswordChanged"
                                             AutomationProperties.Name="Yeni şifre tekrar" />

                                <Button Content="Şifreyi güncelle"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding ResetPasswordCommand}"
                                        HorizontalAlignment="Left"
                                        Margin="0,14,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <Border Background="{DynamicResource AccentSoftBrush}"
                                CornerRadius="10"
                                Padding="14"
                                Visibility="{Binding CanManage, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="Kullanıcı yönetimi yalnızca yöneticiye açıktır."
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource SuccessBrush}"
                   FontSize="12"
                   Margin="2,12,0,0"
                   Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
    </Grid>
</UserControl>

<UserControl x:Class="CgpRandevuTakip.Desktop.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Tercihler" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Tema anında uygulanır. Diğer ayarlar yalnızca yönetici tarafından değiştirilebilir."
                               Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Ayarları kaydet"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveCommand}"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <Border Background="{DynamicResource SuccessSoftBrush}"
                    BorderBrush="{DynamicResource SuccessBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="12,10"
                    Margin="0,0,0,14"
                    Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource SuccessBrush}"
                           FontSize="12"
                           TextWrapping="Wrap" />
            </Border>

            <Border Background="{DynamicResource DangerSoftBrush}"
                    BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="12,10"
                    Margin="0,0,0,14"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource DangerBrush}"
                           FontSize="12"
                           TextWrapping="Wrap" />
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <!-- Görünüm -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Görünüm ve genel" Style="{StaticResource SectionTitle}" />

                            <TextBlock Text="Tema" Style="{StaticResource LabelText}" />
                            <ComboBox ItemsSource="{Binding ThemeOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />
                            <TextBlock Text="Otomatik seçeneği Windows kişiselleştirme ayarını izler."
                                       Style="{StaticResource MutedText}" Margin="0,5,0,0" />

                            <TextBlock Text="Kurum adı (paylaşım başlığı)" Style="{StaticResource LabelText}" Margin="0,16,0,6" />
                            <TextBox Text="{Binding InstitutionName, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsAdmin}"
                                     MaxLength="120"
                                     AutomationProperties.Name="Kurum adı" />
                            <TextBlock Text="Üst çubukta, kontrol panelinde ve günlük liste görselinde görünür."
                                       Style="{StaticResource MutedText}" Margin="0,5,0,0" />

                            <TextBlock Text="Varsayılan hatırlatıcı" Style="{StaticResource LabelText}" Margin="0,16,0,6" />
                            <ComboBox ItemsSource="{Binding ReminderOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedReminder, Mode=TwoWay}"
                                      IsEnabled="{Binding IsAdmin}" />

                            <TextBlock Text="Günlük paylaşım saati (SS:dd)" Style="{StaticResource LabelText}" Margin="0,16,0,6" />
                            <TextBox Text="{Binding DailyShareTime, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsAdmin}"
                                     MaxLength="5" />
                        </StackPanel>
                    </Border>

                    <!-- Çalışma saatleri -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Çalışma saatleri" Style="{StaticResource SectionTitle}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Başlangıç (SS:dd)" Style="{StaticResource LabelText}" />
                                    <TextBox Text="{Binding WorkHoursStart, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="5"
                                             AutomationProperties.Name="Çalışma saati başlangıcı" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Bitiş (SS:dd)" Style="{StaticResource LabelText}" />
                                    <TextBox Text="{Binding WorkHoursEnd, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="5"
                                             AutomationProperties.Name="Çalışma saati bitişi" />
                                </StackPanel>
                            </Grid>

                            <CheckBox Content="Mesai dışında görüşme oluşturulabilsin"
                                      IsChecked="{Binding AllowOutOfHoursAppointments}"
                                      Margin="0,12,0,0"
                                      AutomationProperties.Name="Mesai dışı görüşme" />
                            <TextBlock Text="Randevu saat seçenekleri bu aralığa göre üretilir. Mesai dışı kapalıyken aralık dışına randevu girilemez."
                                       Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Bildirimler -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Bildirimler" Style="{StaticResource SectionTitle}" />

                            <CheckBox Content="Windows bildirimleri açık"
                                      IsChecked="{Binding NotificationsEnabled}"
                                      Margin="0,0,0,10" />
                            <CheckBox Content="Telefon push bildirimi açık"
                                      IsChecked="{Binding PushEnabled}"
                                      Margin="0,0,0,12" />

                            <TextBlock Text="Push sağlayıcısı (seçili olan kullanılır)" Style="{StaticResource LabelText}" />
                            <ComboBox ItemsSource="{Binding PushProviderOptions}"
                                      SelectedItem="{Binding SelectedPushProvider, Mode=TwoWay}"
                                      AutomationProperties.Name="Push sağlayıcısı" />
                            <TextBlock Text="ntfy ve Telegram birlikte desteklenir; hangisini kullanacağınızı buradan seçin."
                                       Style="{StaticResource MutedText}" Margin="0,5,0,0" TextWrapping="Wrap" />

                            <StackPanel Visibility="{Binding IsTelegramProvider, Converter={StaticResource InverseBoolToVisibility}}">
                                <TextBlock Text="Push konusu / topic" Style="{StaticResource LabelText}" Margin="0,14,0,6" />
                                <TextBox Text="{Binding PushTopic, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Push konusu" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsTelegramProvider, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Bot token" Style="{StaticResource LabelText}" Margin="0,14,0,6" />
                                <TextBox Text="{Binding PushToken, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Telegram bot token" />
                                <TextBlock Text="Sohbet kimliği (chat id)" Style="{StaticResource LabelText}" Margin="0,12,0,6" />
                                <TextBox Text="{Binding PushChatId, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Telegram chat id" />
                            </StackPanel>

                            <TextBlock Text="Push varsayılan olarak isimsizdir; bildirimde kişi adı gönderilmez."
                                       Style="{StaticResource MutedText}" Margin="0,8,0,0" />

                            <Button Content="Test bildirimi gönder"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding TestPushCommand}"
                                    HorizontalAlignment="Left"
                                    Margin="0,12,0,0" />

                            <TextBlock Text="Sessiz saatler" Style="{StaticResource SectionTitle}" Margin="0,16,0,0" />
                            <CheckBox Content="Sessiz saatler açık"
                                      IsChecked="{Binding QuietHoursEnabled}"
                                      Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Başlangıç (SS:dd)" Style="{StaticResource LabelText}" />
                                    <TextBox Text="{Binding QuietHoursStart, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Bitiş (SS:dd)" Style="{StaticResource LabelText}" />
                                    <TextBox Text="{Binding QuietHoursEnd, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Sessiz saatte push gönderilmez; Windows bildirimi sessiz gösterilir."
                                       Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Uygulama -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Uygulama" Style="{StaticResource SectionTitle}" />

                            <CheckBox Content="Windows açılışında başlat"
                                      IsChecked="{Binding AutoStartEnabled}"
                                      Margin="0,0,0,10" />
                            <CheckBox Content="Kapatınca tepside çalış"
                                      IsChecked="{Binding CloseToTray}"
                                      Margin="0,0,0,12" />

                            <TextBlock Text="Başlangıç modu" Style="{StaticResource LabelText}" />
                            <ComboBox ItemsSource="{Binding AutoStartModeOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedAutoStartMode, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>

                    <!-- Yedekleme -->
                    <Border Style="{StaticResource Card}"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Yedekleme" Style="{StaticResource SectionTitle}" />

                            <TextBlock Text="Yedek klasörü" Style="{StaticResource LabelText}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding BackupDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1"
                                        Content="Gözat"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding BrowseBackupDirectoryCommand}"
                                        Margin="8,0,0,0" />
                            </Grid>
                            <TextBlock Text="Kaydederken klasörün yazılabilirliği test edilir."
                                       Style="{StaticResource MutedText}" Margin="0,6,0,0" />

                            <CheckBox Content="Otomatik yedekleme açık (günde 2 kez)"
                                      IsChecked="{Binding AutoBackupEnabled}"
                                      Margin="0,14,0,0"
                                      AutomationProperties.Name="Otomatik yedekleme" />
                            <TextBlock Text="Öğle yedeği 12:30'da alınır. Günlük liste öğleden sonra paylaşıldığında ikinci yedek hemen tetiklenir; paylaşım yoksa 18:00'de tamamlanır."
                                       Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap" />

                            <CheckBox Content="Yedekleri parola ile şifrele (AES-256-GCM)"
                                      IsChecked="{Binding BackupEncryptionEnabled}"
                                      Margin="0,14,0,0"
                                      AutomationProperties.Name="Yedek şifreleme" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Parola" Style="{StaticResource LabelText}" />
                                    <PasswordBox x:Name="BackupPasswordBox"
                                                 PasswordChanged="OnBackupPasswordChanged"
                                                 AutomationProperties.Name="Yedek parolası" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Parola (tekrar)" Style="{StaticResource LabelText}" />
                                    <PasswordBox x:Name="BackupPasswordConfirmBox"
                                                 PasswordChanged="OnBackupPasswordConfirmChanged"
                                                 AutomationProperties.Name="Yedek parolası tekrar" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Parola bu bilgisayara bağlı olarak şifrelenip saklanır; otomatik yedeklerde kullanılır. Parolayı kaybederseniz şifreli yedeği geri yükleyemezsiniz."
                                       Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap" />

                            <Border Style="{StaticResource Divider}" />

                            <CheckBox Content="Google Drive'a yedekle (şifreli yedekler)"
                                      IsChecked="{Binding GoogleDriveEnabled}"
                                      Margin="0,0,0,8"
                                      AutomationProperties.Name="Google Drive yedekleme" />
                            <TextBlock Text="Google istemci kimliği" Style="{StaticResource LabelText}" />
                            <TextBox Text="{Binding GoogleClientId, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Google istemci kimliği" />
                            <TextBlock Text="Google istemci gizli anahtarı" Style="{StaticResource LabelText}" Margin="0,8,0,6" />
                            <PasswordBox x:Name="GoogleClientSecretBox"
                                         PasswordChanged="OnGoogleClientSecretChanged"
                                         AutomationProperties.Name="Google istemci gizli anahtarı" />
                            <TextBlock Text="Drive klasörü" Style="{StaticResource LabelText}" Margin="0,8,0,6" />
                            <TextBox Text="{Binding GoogleFolderName, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Google Drive klasörü" />

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Bağlan"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding ConnectGoogleDriveCommand}"
                                        Margin="0,0,8,0" />
                                <Button Content="Bağlantıyı kes"
                                        Style="{StaticResource GhostButton}"
                                        Command="{Binding DisconnectGoogleDriveCommand}" />
                            </StackPanel>
                            <TextBlock Text="{Binding GoogleDriveStatus}"
                                       Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                            <TextBlock Text="Google Cloud'da Masaüstü uygulaması türünde OAuth istemcisi oluşturup kimlik bilgilerini buraya girin. Yalnızca drive.file kapsamı kullanılır."
                                       Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <!-- Hesap -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Hesap" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Parolanızı değiştirmek için mevcut şifrenizi doğrulamanız gerekir."
                                       Style="{StaticResource MutedText}" Margin="0,0,0,14" />
                            <Button Content="Şifre değiştir"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ChangePasswordCommand}"
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <!-- E-posta / SMTP -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="E-posta (şifre sıfırlama)" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Kullanıcıların e-posta ile şifre sıfırlayabilmesi için SMTP ayarları."
                                       Style="{StaticResource MutedText}" Margin="0,-6,0,12" />

                            <TextBlock Text="SMTP sunucusu" Style="{StaticResource LabelText}" />
                            <TextBox Text="{Binding SmtpHost, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="SMTP sunucusu" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Port" Style="{StaticResource LabelText}" />
                                    <TextBox Text="{Binding SmtpPort, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="SMTP portu" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                    <CheckBox Content="SSL/TLS kullan"
                                              IsChecked="{Binding SmtpUseSsl}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Kullanıcı adı" Style="{StaticResource LabelText}" Margin="0,12,0,6" />
                            <TextBox Text="{Binding SmtpUsername, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="SMTP kullanıcı adı" />

                            <TextBlock Text="Şifre" Style="{StaticResource LabelText}" Margin="0,12,0,6" />
                            <TextBox Text="{Binding SmtpPassword, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="SMTP şifresi" />

                            <TextBlock Text="Gönderen adresi" Style="{StaticResource LabelText}" Margin="0,12,0,6" />
                            <TextBox Text="{Binding SmtpFromAddress, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="SMTP gönderen adresi" />

                            <TextBlock Text="Gönderen adı" Style="{StaticResource LabelText}" Margin="0,12,0,6" />
                            <TextBox Text="{Binding SmtpFromName, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="SMTP gönderen adı" />

                            <TextBlock Text="Test alıcısı (boşsa gönderen adresi)" Style="{StaticResource LabelText}" Margin="0,12,0,6" />
                            <TextBox Text="{Binding TestEmailAddress, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="SMTP test alıcısı" />

                            <Button Content="Test e-postası gönder"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding TestEmailCommand}"
                                    HorizontalAlignment="Left"
                                    Margin="0,12,0,0" />
                            <TextBlock Text="Önce ayarları kaydedin; test kayıtlı SMTP değerlerini kullanır."
                                       Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Tanılama -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Araçlar" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Günlük paylaşım ve bildirim testleri."
                                       Style="{StaticResource MutedText}" Margin="0,0,0,14" />

                            <Button Content="Bugünün listesini paylaş"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding OpenDailyShareCommand}"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,0,0,8" />
                            <Button Content="Windows toast testi"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding TestWindowsToastCommand}"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,0,0,8" />
                            <Button Content="Veri klasörünü aç"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding OpenDataFolderCommand}"
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <!-- Hakkında -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Hakkında" Style="{StaticResource SectionTitle}" />

                            <TextBlock Text="{Binding ProductName}" FontSize="16" FontWeight="Bold" />
                            <TextBlock Text="{Binding VersionText}" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                            <TextBlock Text="{Binding Copyright}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />

                            <Border Style="{StaticResource Divider}" Margin="0,16" />

                            <TextBlock Text="DİSK ŞİFRELEME (BITLOCKER)" Style="{StaticResource LabelText}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding BitLockerText}"
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap" />
                            <Button Content="Kontrol et"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding CheckBitLockerCommand}"
                                    HorizontalAlignment="Left"
                                    Margin="0,6,0,14" />

                            <TextBlock Text="VERİTABANI" Style="{StaticResource LabelText}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding DatabasePath}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />

                            <TextBlock Text="GÜNLÜKLER" Style="{StaticResource LabelText}" Margin="0,12,0,2" />
                            <TextBlock Text="{Binding LogsDirectory}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />

                            <TextBlock Text="Kişisel veriler bu bilgisayarda tutulur. Yedekleri yalnızca bu bilgisayarda bırakmayın."
                                       Style="{StaticResource MutedText}" Margin="0,14,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

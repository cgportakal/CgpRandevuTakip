<Window x:Class="CgpRandevuTakip.Desktop.Views.SetupWindow"
        Icon="/Assets/CGPRandevuTakip.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Height="830" Width="1180"
        MinHeight="720" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sol: marka ve adım listesi -->
        <Border Grid.Column="0" Background="{DynamicResource BrandGradientBrush}">
            <Grid>
                <Ellipse Width="420" Height="420" Fill="#1FFFFFFF"
                         HorizontalAlignment="Left" VerticalAlignment="Top"
                         Margin="-150,-160,0,0" />

                <Grid Margin="26,28,22,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="38" Height="38" CornerRadius="11" Background="#33FFFFFF">
                                <TextBlock Text="CGP"
                                           Foreground="White"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="CGP - Randevu Takip"
                                           Foreground="White"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Kurulum sihirbazı"
                                           Foreground="#CCFFFFFF"
                                           FontSize="11" />
                            </StackPanel>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Steps}" Margin="0,28,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row"
                                            CornerRadius="10"
                                            Padding="10,8"
                                            Margin="0,0,0,4"
                                            Background="Transparent">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border x:Name="Badge"
                                                    Width="22" Height="22"
                                                    CornerRadius="11"
                                                    Background="#26FFFFFF"
                                                    VerticalAlignment="Center">
                                                <TextBlock x:Name="BadgeText"
                                                           Text="{Binding Badge}"
                                                           Foreground="White"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>

                                            <TextBlock x:Name="StepTitle"
                                                       Grid.Column="1"
                                                       Text="{Binding Title}"
                                                       Foreground="#D9FFFFFF"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding OptionalLabel}"
                                                       Foreground="#99FFFFFF"
                                                       FontSize="10"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IsOptional, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                    </Border>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="#26FFFFFF" />
                                            <Setter TargetName="StepTitle" Property="Foreground" Value="White" />
                                            <Setter TargetName="StepTitle" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                            <Setter TargetName="Badge" Property="Background" Value="#4DFFFFFF" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <Border Style="{StaticResource Divider}" Background="#33FFFFFF" Margin="0,0,0,12" />
                        <TextBlock Text="Veriler bu bilgisayarda tutulur."
                                   Foreground="#D9FFFFFF"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding VersionText}"
                                   Foreground="#99FFFFFF"
                                   FontSize="10"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Sağ: adım içeriği -->
        <Grid Grid.Column="1" Margin="34,26,34,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="{Binding HeaderTitle}" Style="{StaticResource PageTitle}" FontSize="24" />
                <TextBlock Text="{Binding HeaderSubtitle}"
                           Style="{StaticResource PageSubtitle}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,10">
                <Grid MaxWidth="800" HorizontalAlignment="Left">

                    <!-- 0 · HOŞ GELDİNİZ -->
                    <StackPanel Visibility="{Binding IsWelcomeStep, Converter={StaticResource BoolToVisibility}}">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Kurulumda neler yapılacak?"
                                           Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Zorunlu adımlar kurum bilgileri, yönetici hesabı ve görünüm tercihleridir. E-posta, telefon bildirimleri ve yedekleme adımlarını isterseniz atlayabilir, daha sonra Ayarlar'dan tamamlayabilirsiniz."
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <UniformGrid Columns="2" Margin="0,14,0,0">
                            <Border Style="{StaticResource SoftCard}" Margin="0,0,7,7">
                                <StackPanel>
                                    <TextBlock Text="1 · Kurum ve yönetici" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="Kurum adı, e-posta, telefon ve adres; ardından yönetici hesabı."
                                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SoftCard}" Margin="7,0,0,7">
                                <StackPanel>
                                    <TextBlock Text="2 · Görünüm ve tercihler" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="Tema canlı uygulanır; çalışma saatleri ve paylaşım saati belirlenir."
                                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SoftCard}" Margin="0,7,7,0">
                                <StackPanel>
                                    <TextBlock Text="3 · İsteğe bağlı entegrasyonlar" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="SMTP e-posta, telefon bildirimleri ve yedekleme. Atlanabilir."
                                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SoftCard}" Margin="7,7,0,0">
                                <StackPanel>
                                    <TextBlock Text="4 · Özet ve tamamla" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="Bilgileri kontrol edin; ayarlar tek seferde kaydedilir."
                                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <TextBlock Text="Kurulumu tamamladıktan sonra bu sihirbazı Ayarlar > Araçlar bölümünden yeniden çalıştırarak bilgileri güncelleyebilirsiniz."
                                   Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap"
                                   Margin="0,14,0,0" />
                    </StackPanel>

                    <!-- 1 · KURUM BİLGİLERİ -->
                    <StackPanel Visibility="{Binding IsInstitutionStep, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Kurum adı" Style="{StaticResource LabelText}" />
                        <TextBox Text="{Binding InstitutionName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Kurum adı" />
                        <TextBlock Text="Başlıkta, günlük liste görselinde ve e-posta gönderiminde görünür."
                                   Style="{StaticResource MutedText}" Margin="0,5,0,0" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Kurum e-posta adresi" Style="{StaticResource LabelText}" />
                                <TextBox Text="{Binding InstitutionEmail, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Kurum e-posta" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Telefon" Style="{StaticResource LabelText}" />
                                <TextBox Text="{Binding InstitutionPhone, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Kurum telefonu" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="E-posta, SMTP gönderen adresi için varsayılan olur; şifre sıfırlama bildirimlerinde kullanılır."
                                   Style="{StaticResource MutedText}" Margin="0,5,0,0" TextWrapping="Wrap" />

                        <TextBlock Text="Adres" Style="{StaticResource LabelText}" Margin="0,14,0,6" />
                        <TextBox Text="{Binding InstitutionAddress, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Kurum adresi"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="66"
                                 VerticalScrollBarVisibility="Auto" />

                        <TextBlock Text="Kurum logosu (isteğe bağlı)" Style="{StaticResource LabelText}" Margin="0,16,0,6" />
                        <Border Style="{StaticResource SoftCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="88" Height="88"
                                        CornerRadius="10"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Image Source="{Binding LogoPreview}"
                                               Stretch="Uniform"
                                               Margin="6"
                                               Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="Logo yok"
                                                   Style="{StaticResource MutedText}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding HasLogo, Converter={StaticResource InverseBoolToVisibility}}" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LogoFormatsText}"
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="Logo, WhatsApp için üretilen günlük liste görselinin üstünde yer alır."
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <Button Content="Logo seç"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding PickLogoCommand}"
                                            MinWidth="96" />
                                    <Button Content="Kaldır"
                                            Style="{StaticResource GhostButton}"
                                            Command="{Binding RemoveLogoCommand}"
                                            Margin="0,6,0,0"
                                            Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- 2 · YÖNETİCİ HESABI -->
                    <StackPanel Visibility="{Binding IsAdminStep, Converter={StaticResource BoolToVisibility}}">

                        <!-- İlk kurulum -->
                        <StackPanel Visibility="{Binding IsFirstRunMode, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Ad soyad" Style="{StaticResource LabelText}" />
                            <TextBox Text="{Binding AdminDisplayName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Yönetici ad soyad" />

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Kullanıcı adı" Style="{StaticResource LabelText}" />
                                    <TextBox Text="{Binding AdminUsername, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Yönetici kullanıcı adı" />
                                    <TextBlock Text="En az 3 karakter; harf, rakam, nokta, tire veya alt çizgi."
                                               Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="E-posta" Style="{StaticResource LabelText}" />
                                    <TextBox Text="{Binding AdminEmail, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Yönetici e-posta" />
                                    <TextBlock Text="Şifre sıfırlama için zorunludur."
                                               Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Şifre" Style="{StaticResource LabelText}" />
                                    <PasswordBox x:Name="PasswordBox" PasswordChanged="OnPasswordChanged" AutomationProperties.Name="Yönetici şifre" />
                                    <TextBlock Text="En az 8 karakter, en az bir harf ve bir rakam."
                                               Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Şifre (tekrar)" Style="{StaticResource LabelText}" />
                                    <PasswordBox x:Name="ConfirmPasswordBox" PasswordChanged="OnConfirmPasswordChanged" AutomationProperties.Name="Yönetici şifre tekrar" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Güncelleme modu -->
                        <StackPanel Visibility="{Binding IsUpdateMode, Converter={StaticResource BoolToVisibility}}">
                            <Border Style="{StaticResource SoftCard}">
                                <StackPanel>
                                    <TextBlock Text="Yönetici hesabı" Style="{StaticResource LabelText}" />
                                    <TextBlock Text="{Binding AdminDisplayName}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding AdminUsername}"
                                               Style="{StaticResource MutedText}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="E-posta" Style="{StaticResource LabelText}" Margin="0,16,0,6" />
                            <TextBox Text="{Binding AdminEmail, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Yönetici e-posta" />
                            <TextBlock Text="Şifre sıfırlama ve bilgilendirme e-postaları bu adrese gönderilir."
                                       Style="{StaticResource MutedText}" Margin="0,5,0,0" />

                            <CheckBox Content="Şifremi değiştir"
                                      IsChecked="{Binding ChangePassword}"
                                      Margin="0,18,0,0" />

                            <StackPanel Visibility="{Binding ChangePassword, Converter={StaticResource BoolToVisibility}}"
                                        Margin="0,10,0,0">
                                <TextBlock Text="Mevcut şifre" Style="{StaticResource LabelText}" />
                                <PasswordBox x:Name="CurrentPasswordBox" PasswordChanged="OnCurrentPasswordChanged" AutomationProperties.Name="Mevcut şifre" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Yeni şifre" Style="{StaticResource LabelText}" />
                                        <PasswordBox x:Name="NewPasswordBox" PasswordChanged="OnNewPasswordChanged" AutomationProperties.Name="Yeni şifre" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Yeni şifre (tekrar)" Style="{StaticResource LabelText}" />
                                        <PasswordBox x:Name="NewConfirmPasswordBox" PasswordChanged="OnNewConfirmPasswordChanged" AutomationProperties.Name="Yeni şifre tekrar" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Şifre değiştiğinde oturumunuz açık kalır; diğer oturumlar geçersiz olur."
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- 3 · GÖRÜNÜM VE TERCİHLER -->
                    <StackPanel Visibility="{Binding IsPreferencesStep, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Tema" Style="{StaticResource LabelText}" />
                                <ComboBox ItemsSource="{Binding ThemeOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />
                                <TextBlock Text="Seçim yapıldığı anda uygulanır. Kurulum tamamlanınca kalıcı kaydedilir."
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Varsayılan hatırlatıcı" Style="{StaticResource LabelText}" />
                                <ComboBox ItemsSource="{Binding ReminderOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedReminder, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Çalışma saatleri" Style="{StaticResource SectionTitle}" Margin="0,20,0,0" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Başlangıç (SS:dd)" Style="{StaticResource LabelText}" />
                                <TextBox Text="{Binding WorkHoursStart, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Çalışma saati başlangıç" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Bitiş (SS:dd)" Style="{StaticResource LabelText}" />
                                <TextBox Text="{Binding WorkHoursEnd, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Çalışma saati bitiş" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Günlük paylaşım saati" Style="{StaticResource LabelText}" />
                                <TextBox Text="{Binding DailyShareTime, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Günlük paylaşım saati" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Randevu saat seçenekleri çalışma saatlerine göre üretilir. Günlük paylaşım saati WhatsApp listesinin hazırlanma zamanıdır."
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0" />

                        <TextBlock Text="Uygulama" Style="{StaticResource SectionTitle}" Margin="0,20,0,0" />
                        <CheckBox Content="Windows açılışında gizli başlat (bildirimler arka planda çalışır)"
                                  IsChecked="{Binding AutoStartEnabled}"
                                  Margin="0,10,0,0" />
                        <CheckBox Content="Pencere kapatılınca tepside çalışmaya devam et"
                                  IsChecked="{Binding CloseToTray}"
                                  Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- 4 · SMTP -->
                    <StackPanel Visibility="{Binding IsSmtpStep, Converter={StaticResource BoolToVisibility}}">
                        <Border Style="{StaticResource SoftCard}">
                            <TextBlock Text="Bu adımı atlarsanız şifre sıfırlama e-postaları gönderilemez. Daha sonra Ayarlar > E-posta bölümünden yapılandırabilirsiniz."
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="SMTP sunucusu" Style="{StaticResource LabelText}" />
                                <TextBox Text="{Binding SmtpHost, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="SMTP sunucusu" />
                                <TextBlock Text="Örn: smtp.gmail.com"
                                           Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Port" Style="{StaticResource LabelText}" />
                                <TextBox Text="{Binding SmtpPort, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="SMTP portu" />
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="SSL/TLS kullan (genellikle 587 veya 465)"
                                  IsChecked="{Binding SmtpUseSsl}"
                                  Margin="0,12,0,0" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Kullanıcı adı" Style="{StaticResource LabelText}" />
                                <TextBox Text="{Binding SmtpUsername, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="SMTP kullanıcı adı" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Parola" Style="{StaticResource LabelText}" />
                                <PasswordBox x:Name="SmtpPasswordBox" PasswordChanged="OnSmtpPasswordChanged" AutomationProperties.Name="SMTP parolası" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Gönderen adresi" Style="{StaticResource LabelText}" />
                                <TextBox Text="{Binding SmtpFromAddress, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="SMTP gönderen adresi" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Gönderen adı" Style="{StaticResource LabelText}" />
                                <TextBox Text="{Binding SmtpFromName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="SMTP gönderen adı" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Gmail kullanıyorsanız normal hesap şifresi değil, Google hesabınızda oluşturduğunuz uygulama şifresini girin."
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0" />

                        <Border Style="{StaticResource Divider}" Margin="0,16,0,12" />

                        <TextBlock Text="Test gönderimi (isteğe bağlı)" Style="{StaticResource LabelText}" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Text="{Binding TestEmailAddress, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="SMTP test alıcısı" />
                            <Button Grid.Column="2"
                                    Content="Test e-postası gönder"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding SendTestEmailCommand}" />
                        </Grid>

                        <TextBlock Text="{Binding SmtpTestMessage}"
                                   Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Visibility="{Binding SmtpTestMessage, Converter={StaticResource StringToVisibility}}" />
                    </StackPanel>

                    <!-- 5 · TELEFON BİLDİRİMLERİ -->
                    <StackPanel Visibility="{Binding IsPushStep, Converter={StaticResource BoolToVisibility}}">
                        <Border Style="{StaticResource SoftCard}">
                            <TextBlock Text="Windows bildirimleri her zaman çalışır. Telefon bildirimi istemiyorsanız bu adımı atlayın; daha sonra Ayarlar > Bildirimler bölümünden açabilirsiniz."
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <CheckBox Content="Telefon bildirimlerini aç"
                                  IsChecked="{Binding PushEnabled}"
                                  Margin="0,16,0,0" />

                        <StackPanel Visibility="{Binding PushEnabled, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Sağlayıcı" Style="{StaticResource LabelText}" Margin="0,16,0,6" />
                            <ComboBox ItemsSource="{Binding PushProviderOptions}"
                                      SelectedItem="{Binding SelectedPushProvider, Mode=TwoWay}"
                                      Width="220"
                                      HorizontalAlignment="Left" />

                            <!-- ntfy -->
                            <StackPanel Visibility="{Binding IsNtfyProvider, Converter={StaticResource BoolToVisibility}}"
                                        Margin="0,14,0,0">
                                <TextBlock Text="ntfy topic" Style="{StaticResource LabelText}" />
                                <TextBox Text="{Binding PushTopic, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Push topic" />
                                <TextBlock Text="Telefonunuzda ntfy uygulamasını kurun, aynı topic'e abone olun ve test gönderin."
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            </StackPanel>

                            <!-- Telegram -->
                            <StackPanel Visibility="{Binding IsTelegramProvider, Converter={StaticResource BoolToVisibility}}"
                                        Margin="0,14,0,0">
                                <TextBlock Text="Bot token" Style="{StaticResource LabelText}" />
                                <TextBox Text="{Binding PushToken, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Telegram bot token" />
                                <TextBlock Text="@BotFather üzerinden bot oluşturup size verilen token'ı girin."
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,0" />

                                <TextBlock Text="Sohbet kimliği (chat id)" Style="{StaticResource LabelText}" Margin="0,12,0,6" />
                                <TextBox Text="{Binding PushChatId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Telegram chat id" />
                                <TextBlock Text="Bota bir kez /start mesajı gönderin; chat id sayısal olmalıdır."
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            </StackPanel>

                            <Button Content="Test bildirimi gönder"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding SendTestPushCommand}"
                                    HorizontalAlignment="Left"
                                    Margin="0,14,0,0" />

                            <TextBlock Text="{Binding PushTestMessage}"
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding PushTestMessage, Converter={StaticResource StringToVisibility}}" />

                            <TextBlock Text="Sessiz saatler" Style="{StaticResource SectionTitle}" Margin="0,20,0,0" />
                            <CheckBox Content="Sessiz saatlerde bildirim gönderme"
                                      IsChecked="{Binding QuietHoursEnabled}"
                                      Margin="0,10,0,0" />

                            <Grid Margin="0,10,0,0"
                                  Visibility="{Binding QuietHoursEnabled, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Başlangıç (SS:dd)" Style="{StaticResource LabelText}" />
                                    <TextBox Text="{Binding QuietHoursStart, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Sessiz saat başlangıç" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Bitiş (SS:dd)" Style="{StaticResource LabelText}" />
                                    <TextBox Text="{Binding QuietHoursEnd, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Sessiz saat bitiş" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Bildirimlerde görüşmeci ve kişi adı gösterilir; sessiz saatte push gönderilmez."
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 6 · YEDEKLEME -->
                    <StackPanel Visibility="{Binding IsBackupStep, Converter={StaticResource BoolToVisibility}}">
                        <Border Style="{StaticResource SoftCard}">
                            <TextBlock Text="Yedekleme isteğe bağlıdır; ancak veri kaybına karşı önerilir. Bu adımı atlarsanız varsayılan klasör ve otomatik yedek ayarları korunur."
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <TextBlock Text="Yedek klasörü" Style="{StaticResource LabelText}" Margin="0,16,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding BackupDirectory, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Yedek klasörü" />
                            <Button Grid.Column="2"
                                    Content="Gözat"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding BrowseBackupDirectoryCommand}" />
                        </Grid>

                        <CheckBox Content="Otomatik yedek al (günde iki kez)"
                                  IsChecked="{Binding AutoBackupEnabled}"
                                  Margin="0,14,0,0" />

                        <CheckBox Content="Yedekleri parola ile şifrele"
                                  IsChecked="{Binding BackupEncryptionEnabled}"
                                  Margin="0,10,0,0" />

                        <Grid Margin="0,10,0,0"
                              Visibility="{Binding BackupEncryptionEnabled, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Yedek parolası" Style="{StaticResource LabelText}" />
                                <PasswordBox x:Name="BackupPasswordBox" PasswordChanged="OnBackupPasswordChanged" AutomationProperties.Name="Yedek parolası" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Parola (tekrar)" Style="{StaticResource LabelText}" />
                                <PasswordBox x:Name="BackupPasswordConfirmBox" PasswordChanged="OnBackupPasswordConfirmChanged" AutomationProperties.Name="Yedek parolası tekrar" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Parola bu bilgisayara bağlı olarak şifrelenip saklanır. Parolayı kaybederseniz şifreli yedeği geri yükleyemezsiniz."
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0" />

                        <TextBlock Text="Google Drive for Desktop" Style="{StaticResource SectionTitle}" Margin="0,20,0,0" />
                        <CheckBox Content="Yedekleri Drive klasörüne de kopyala"
                                  IsChecked="{Binding GoogleDriveEnabled}"
                                  Margin="0,10,0,0" />

                        <StackPanel Visibility="{Binding GoogleDriveEnabled, Converter={StaticResource BoolToVisibility}}"
                                    Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding GoogleDriveFolder, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Google Drive klasörü" />
                                <Button Grid.Column="2"
                                        Content="Bul"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding DetectGoogleDriveFolderCommand}" />
                                <Button Grid.Column="4"
                                        Content="Gözat"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding BrowseGoogleDriveFolderCommand}" />
                            </Grid>

                            <TextBlock Text="{Binding GoogleDriveStatus}"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,6,0,0" />
                            <TextBlock Text="Google Drive for Desktop kurulu ve senkronize olmalıdır; şifreleme açık olmadan Drive kopyası kullanılamaz."
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 7 · ÖZET -->
                    <StackPanel Visibility="{Binding IsSummaryStep, Converter={StaticResource BoolToVisibility}}">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Kurum" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding SummaryInstitutionText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                <TextBlock Text="{Binding SummaryAddressText}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding SummaryLogoText}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Yönetici hesabı" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding SummaryAdminText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                <TextBlock Text="{Binding SummaryAdminSecurityText}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Görünüm ve tercihler" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding SummaryPreferencesText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="E-posta / SMTP" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding SummarySmtpText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Telefon bildirimleri" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding SummaryPushText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Yedekleme" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding SummaryBackupText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Kurulumu tamamladığınızda yönetici hesabı oluşturulur, ayarlar kaydedilir ve tema uygulanır. Test edilmeyen entegrasyonları daha sonra Ayarlar'dan doğrulayabilirsiniz."
                                   Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap"
                                   Margin="0,14,0,0" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Background="{DynamicResource DangerSoftBrush}"
                        BorderBrush="{DynamicResource DangerBrush}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="12,10"
                        Margin="0,0,0,10"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource DangerBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </Border>

                <Grid Grid.Row="1">
                    <Button Content="Geri"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding BackCommand}"
                            HorizontalAlignment="Left"
                            MinWidth="92"
                            Visibility="{Binding IsFirstStep, Converter={StaticResource InverseBoolToVisibility}}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Kaydediliyor..."
                                   Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                        <Button Content="Atla"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding SkipCommand}"
                                MinWidth="80"
                                Margin="0,0,8,0"
                                Visibility="{Binding CanSkipCurrentStep, Converter={StaticResource BoolToVisibility}}" />

                        <Button Content="{Binding ContinueText}"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding ContinueCommand}"
                                IsDefault="True"
                                MinWidth="170" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>

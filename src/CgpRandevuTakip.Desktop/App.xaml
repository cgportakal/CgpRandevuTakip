<Application x:Class="CgpRandevuTakip.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:CgpRandevuTakip.Desktop.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <converters:StringToVisibilityConverter x:Key="StringToVisibility" />
            <converters:InverseStringToVisibilityConverter x:Key="StringToVisibilityInverse" />
            <converters:HexToBrushConverter x:Key="HexToBrush" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
